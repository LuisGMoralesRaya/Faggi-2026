{%- assign bst = block.settings -%}
<div class="theme-blocks-item number-block text-{{ bst.text_alignment }}{% if bst.width == 'max_content' %} m-{{ bst.alignment }}-auto{% endif %}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px; background: {{ bst.bg }}; border-radius: {{ bst.corner }}px; padding: {{ bst.padding_block }}px {{ bst.padding_inline }}px;--color-hover: {{ bst.number_color }};--color-title: {{ bst.title_color }};{% if bst.width == 'max_content' %}width: max-content;max-width: 100%{% endif %}">
  <div class="number-block__number d-inline-flex align-items-center fs-{{ bst.number_fs_xl }} fs-lg-{{ bst.number_fs_lg }} fs-sm-{{ bst.number_fs_sm }} {{ bst.number_fw }} h2 color-act">
    <span class="number-block__number-value{% if bst.number_animation %} number-animate{% endif %}" data-number="{{ bst.number }}">{{ bst.number }}</span>
    <span class="number-block__number-unit">{{ bst.unit }}</span>
  </div>
  <div class="number-block__title fs-{{ bst.title_fs_xl }} fs-lg-{{ bst.title_fs_lg }} fs-sm-{{ bst.title_fs_sm }} {{ bst.title_fw }} color-title">{{ bst.title }}</div>
</div>
{% schema %}
  {
    "name": "Number",
    "tag": null,
    "settings": [
      {
        "type": "number",
        "id": "number",
        "label": "Number",
