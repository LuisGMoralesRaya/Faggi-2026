        "default": 0,
        "info": "Breakpoint 576px"
      },
      {
        "type": "number",
        "id": "mb_xs",
        "label": "Mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Card"
      }
    ]
  }
