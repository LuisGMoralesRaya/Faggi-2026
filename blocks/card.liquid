{%- liquid
  assign bst = block.settings

  assign style_padding_left = '--pl-xl: ' | append: bst.pl_xl | append: 'px; --pl-lg: ' | append: bst.pl_lg | append: 'px; --pl-md: ' | append: bst.pl_md | append: 'px; --pl-sm: ' | append: bst.pl_sm | append: 'px; --pl-xs: ' | append: bst.pl_xs | append: 'px;'
  assign style_padding_right = '--pr-xl: ' | append: bst.pr_xl | append: 'px; --pr-lg: ' | append: bst.pr_lg | append: 'px; --pr-md: ' | append: bst.pr_md | append: 'px; --pr-sm: ' | append: bst.pr_sm | append: 'px; --pr-xs: ' | append: bst.pr_xs | append: 'px;'

-%}
{% style %}
  #block-{{ block.id }} .block-container {
    border: 1px solid {{ bst.bd_color }};
    border-radius: {{ bst.corner_radius }}px;
    {% if bst.show_bg %}--bg-color: {{ bst.bg_color }};{% endif %}
    {% if bst.pl_enable %}{{ style_padding_left }}{% endif %}
    {% if bst.pr_enable %}{{ style_padding_right }}{% endif %}
    {% if bst.style_hover %}
      --bg-color-hover: {{ bst.bg_color_hover }};
      --color-border-hover: {{ bst.border_color_hover }};
    {% endif %}
  }
  {% if bst.bg_image != blank %}
    #block-{{ block.id }} .block-container.bg {
      background-image: url("{{ bst.bg_image | image_url: width: 960 }}");
    }
  {% endif %}
  {% if bst.show_box_shadow %}
    #block-{{ block.id }} .block-container {
      box-shadow: {{ bst.shadow_x }}px {{ bst.shadow_y }}px {{ bst.shadow_size }}px {{ bst.shadow_color }};
    }
  {% endif %}
  {% if bst.show_box_shadow_hover %}
    #block-{{ block.id }}.style-hover:hover .block-container {
      box-shadow: {{ bst.shadow_x }}px {{ bst.shadow_y }}px {{ bst.shadow_size }}px {{ bst.shadow_color }};
    }
  {% endif %}
{% endstyle %}

<div id="block-{{ block.id }}" class="theme-blocks-item card-block{% if bst.style_hover %} style-hover{% endif %}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;">
  <div class="block-container h-100{% if bst.show_bg %} bg{% endif %}">
    <div class="col-block-content position-relative{% if bst.pl_enable %} pl{% endif %}{% if bst.pr_enable %} pr{% endif %}">
      {%- if bst.label_top != blank -%}
        <div class="label_top color-{{ bst.label_color }}">
          {{ bst.label_top }}
        </div>
      {%- endif -%}
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Card",
    "tag": null,
    "blocks": [
      { 
        "type": "@theme"
      },
      { 
        "type": "@app"
      }
    ],
    "settings": [
      {
        "type": "header",
        "content": "Background"
      },
      {
        "type": "checkbox",
        "id": "show_bg",
        "label": "Show background"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background color",
        "default": "#f2f2f2"
      },
      {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background image"
      },
      {
        "type": "header",
        "content": "Border"
      },
      {
        "type": "color",
        "id": "bd_color",
        "alpha": true,
        "label": "Border color",
        "default": "#d2d2d2"
      },
      {
        "type": "header",
        "content": "Box shadow"
      },
      {
        "type": "checkbox",
        "id": "show_box_shadow",
        "label": "Show box shadow",
      },
      {
        "type": "number",
        "id": "shadow_x",
        "label": "Horizontal",
        "default": 5,
        "info": "Unit: px",
        "visible_if": "{{ block.settings.show_box_shadow or block.settings.show_box_shadow_hover }}"
      },
      {
        "type": "number",
        "id": "shadow_y",
        "label": "Vertical",
        "default": 5,
        "info": "Unit: px",
        "visible_if": "{{ block.settings.show_box_shadow or block.settings.show_box_shadow_hover }}"
      },
      {
        "type": "number",
        "id": "shadow_size",
        "label": "Size",
        "default": 20,
        "info": "Unit: px",
        "visible_if": "{{ block.settings.show_box_shadow or block.settings.show_box_shadow_hover }}"
      },
      {
        "type": "color",
        "id": "shadow_color",
        "label": "Color",
        "alpha": true,
        "default": "#00000033"
      },
      {
        "type": "header",
        "content": "Corner radius"
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Corner radius",
        "default": 0
      },
      {
        "type": "header",
        "content": "Style Hover"
      },
      {
        "type": "checkbox",
        "id": "style_hover",
        "label": "Enable style when hover"
      },
      {
        "type": "color",
        "id": "bg_color_hover",
        "label": "Background color",
        "default": "#f2f2f2",
        "visible_if": "{{ block.settings.style_hover }}"
      },
      {
        "type": "color",
        "id": "border_color_hover",
        "label": "Border color",
        "default": "#f2f2f2",
        "visible_if": "{{ block.settings.style_hover }}"
      },
      {
        "type": "checkbox",
        "id": "show_box_shadow_hover",
        "label": "Show box shadow"
      },
      {
        "type": "header",
        "content": "Label Top"
      },
      {
        "type": "text",
        "id": "label_top",
        "label": "Label"
      },
      {
        "type": "color_scheme",
        "id": "label_color",
        "label": "Color",
        "default": "background-1",
        "visible_if": "{{ block.settings.label_top != blank }}"
      },
      {
        "type": "header",
        "content": "Padding Left"
      },
      {
        "type": "checkbox",
        "id": "pl_enable",
        "label": "Enable padding left",
        "default": false
      },
      {
        "type": "paragraph",
        "content": "Unit: px"
      },
      {
        "type": "number",
        "id": "pl_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px",
        "visible_if": "{{ block.settings.pl_enable }}"
      },
      {
        "type": "number",
        "id": "pl_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px",
        "visible_if": "{{ block.settings.pl_enable }}"
      },
      {
        "type": "number",
        "id": "pl_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px",
        "visible_if": "{{ block.settings.pl_enable }}"
      },
      {
        "type": "number",
        "id": "pl_sm",
        "label": "Large mobile",
        "default": 0,
        "info": "Breakpoint 576px",
        "visible_if": "{{ block.settings.pl_enable }}"
      },
      {
        "type": "number",
        "id": "pl_xs",
        "label": "Mobile",
        "default": 0,
        "visible_if": "{{ block.settings.pl_enable }}"
      },
      {
        "type": "header",
        "content": "Padding Right"
      },
      {
        "type": "checkbox",
        "id": "pr_enable",
        "label": "Enable padding right",
        "default": false
      },
      {
        "type": "paragraph",
        "content": "Unit: px"
      },
      {
        "type": "number",
        "id": "pr_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px",
        "visible_if": "{{ block.settings.pr_enable }}"
      },
      {
        "type": "number",
        "id": "pr_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px",
        "visible_if": "{{ block.settings.pr_enable }}"
      },
      {
        "type": "number",
        "id": "pr_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px",
        "visible_if": "{{ block.settings.pr_enable }}"
      },
      {
        "type": "number",
        "id": "pr_sm",
        "label": "Large mobile",
        "default": 0,
        "info": "Breakpoint 576px",
        "visible_if": "{{ block.settings.pr_enable }}"
      },
      {
        "type": "number",
        "id": "pr_xs",
        "label": "Mobile",
        "default": 0,
        "visible_if": "{{ block.settings.pr_enable }}"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Large Mobile",
        "default": 0,
        "info": "Breakpoint 576px"
      },
      {
        "type": "number",
        "id": "mt_xs",
        "label": "Mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
