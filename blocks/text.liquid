{%- assign bst = block.settings -%}

{%- liquid
  assign class_text = bst.font_family | append: ' ' | append: bst.font_weight | append: ' fs-' | append: bst.font_size_xxl | append: ' fs-xl-' | append: bst.font_size_xl | append: ' fs-lg-' | append: bst.font_size_lg | append: ' fs-md-' | append: bst.font_size_md | append: ' fs-sm-' | append: bst.font_size_sm | append: ' fs-xs-' | append: bst.font_size_xs

  assign style_text = 'color: ' | append: bst.color | append: '; --color-link: ' | append: bst.color_link | append: '; --color-link-hover: ' | append: bst.color_link_hover | append: '; letter-spacing: ' | append: bst.letter_spacing | append: 'px; line-height: ' | append: bst.line_height | append: '; --max-width: ' | append: bst.max_w | append: 'px; --bg-seemore: ' | append: bst.bg_seemore | append: '; --mt-xl: ' | append: bst.mt_xl | append: 'px; --mt-lg: ' | append: bst.mt_lg | append: 'px; --mt-md: ' | append: bst.mt_md | append: 'px; --mt-sm: ' | append: bst.mt_sm | append: 'px; --mb-xl: ' | append: bst.mb_xl | append: 'px; --mb-lg: ' | append: bst.mb_lg | append: 'px; --mb-md: ' | append: bst.mb_md | append: 'px; --mb-sm: ' | append: bst.mb_sm | append: 'px;'
-%}

<div class="theme-blocks-item text-block text-{{ bst.alignment }}{% if bst.responsive_alignment %} text-xl-{{ bst.alignment_xl }} text-lg-{{ bst.alignment_lg }} text-md-{{ bst.alignment_md }}  text-sm-{{ bst.alignment_sm }}{% endif %} {{ bst.text_transform }} {{ class_text }} {% if bst.show_seemore %} nov_item_act position-relative js-height{% endif %}"{% if bst.show_seemore %}data-act="{{ block.id }}" data-max_height="{{ bst.height_seemore }}"{% endif %} style="{{ style_text }}">
  <div class="text-content position-relative d-inline-flex">
    {{ bst.text }}
    {% if bst.pattern != blank %}
      <div class="pattern position-absolute {{ bst.pattern_position }}" style="--width: {{ bst.pattern_width }}%; --horizontal: {{ bst.pattern_horizontal }}%; --vertical: {{ bst.pattern_vertical }}%;">
        {% render 'nov-aspect-image', image: bst.pattern, class: 'no-ef' %}
      </div>
    {% endif %}
  </div>
</div>
{% if bst.show_seemore %}
  <div class="btn-show__content font-700 fs-16 text-center mt-30 nov_btn_act color-title position-relative" data-toggle="{{ block.id }}">
    <span class="see_more pointer color-hover">{{ bst.see_more_label }}{% if bst.show_seemore_icon %}<i class="zmdi zmdi-chevron-down"></i>{% endif %}</span>
    <span class="see_less pointer color-hover">{{ bst.see_less_label }}{% if bst.show_seemore_icon %}<i class="zmdi zmdi-chevron-up"></i>{% endif %}</span>
  </div>
{% endif %}

{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Lorem ipsum dolor sit amet.</p>"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_link",
      "label": "Color link",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_link_hover",
      "label": "Color link hover",
      "default": "#000000"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "responsive_alignment",
      "label": "Responsive alignment"
    },
    {
      "type": "text_alignment",
      "id": "alignment_xl",
      "label": "Large laptop",
      "info": "Breakpoint 1200px ↑",
      "visible_if": "{{ block.settings.responsive_alignment }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment_lg",
      "label": "Laptop",
      "info": "Breakpoint 992px ↑",
      "visible_if": "{{ block.settings.responsive_alignment }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment_md",
      "label": "Tablet",
      "info": "Breakpoint 768px ↑",
      "visible_if": "{{ block.settings.responsive_alignment }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment_ms",
      "label": "Large mobile",
      "info": "Breakpoint 576px ↑",
      "visible_if": "{{ block.settings.responsive_alignment }}"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font family",
      "options": [
        { "value": "f_df", "label": "Body font" },
        { "value": "f_pr", "label": "Heading font" }
      ],
      "default": "f_df"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {"value": "font-100","label": "Thin - 100"},
        {"value": "font-300","label": "Light - 300"},
        {"value": "font-400","label": "Regular - 400"},
        {"value": "font-500","label": "Medium - 500"},
        {"value": "font-600","label": "SemiBold - 600"},
        {"value": "font-700","label": "Bold - 700"},
        {"value": "font-800","label": "ExtraBold - 800"},
        {"value": "font-900","label": "Black - 900"}
      ],
      "default": "font-400"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        { "value": "text-capitalize", "label": "Capitalize" },
        { "value": "text-uppercase", "label": "Uppercase" },
        { "value": "none", "label": "None" }
      ],
      "default": "text-capitalize"
    },
    {
      "type": "text",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "default": "0",
      "info": "Unit: px"
    },
    {
      "type": "text",
      "id": "line_height",
      "label": "Line height",
      "default": "1.5"
    },
    {
      "type": "number",
      "id": "max_w",
      "label": "Max width",
      "default": 960,
      "info": "Unit: px"
    },
    {
      "type": "header",
      "content": "Font Size",
      "info": "Unit: px"
    },
    {
      "type": "range",
      "id": "font_size_xxl",
      "label": "Desktop",
      "info": "Breakpoint 1441px ↑",
      "min": 7,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_xl",
      "label": "Large laptop",
      "info": "Breakpoint 1200px ↑",
      "min": 7,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_lg",
      "label": "Laptop",
      "info": "Breakpoint 992px ↑",
      "min": 7,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_md",
      "label": "Tablet",
      "info": "Breakpoint 768px ↑",
      "min": 7,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_sm",
      "label": "Large mobile",
      "info": "Breakpoint 576px ↑",
      "min": 7,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_xs",
      "label": "Mobile",
      "min": 7,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Show Button See More"
    },
    {
      "type": "checkbox",
      "id": "show_seemore",
      "label": "Show button see more"
    },
    {
      "type": "color",
      "id": "bg_seemore",
      "label": "Background",
      "default": "#fff",
      "info": "Background gradient when show button see more",
      "visible_if": "{{ block.settings.show_seemore == true }}"
    },
    {
      "type": "range",
      "id": "height_seemore",
      "min": 100,
      "max": 300,
      "step": 5,
      "label": "Height",
      "default": 160,
      "unit": "px",
      "info": "Height when show button see more",
      "visible_if": "{{ block.settings.show_seemore == true }}"
    },
    {
      "type": "text",
      "id": "see_more_label",
      "label": "See more label",
      "default": "See more",
      "visible_if": "{{ block.settings.show_seemore == true }}"
    },
    {
      "type": "text",
      "id": "see_less_label",
      "label": "See less label",
      "default": "See less",
      "visible_if": "{{ block.settings.show_seemore == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_seemore_icon",
      "label": "Show icon",
      "default": false,
      "visible_if": "{{ block.settings.show_seemore == true }}"
    },
    {
      "type": "header",
      "content": "Spacing Top (px)"
    },
    {
      "type": "number",
      "id": "mt_xl",
      "label": "Large laptop",
      "default": 0,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mt_lg",
      "label": "Laptop",
      "default": 0,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mt_md",
      "label": "Tablet",
      "default": 0,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mt_sm",
      "label": "Mobile",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing Bottom (px)"
    },
    {
      "type": "number",
      "id": "mb_xl",
      "label": "Large laptop",
      "default": 10,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mb_lg",
      "label": "Laptop",
      "default": 10,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mb_md",
      "label": "Tablet",
      "default": 10,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mb_sm",
      "label": "Mobile",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Text"
    }
  ]
}
{% endschema %}