<div class="nov-accordion__item position-relative nov-slick-dot" data-index="">
  <div class="nov-accordion__title h3 d-flex color-title d-flex align-items-center position-relative mb-0">
    {% content_for 'block', type: "icon", id: "icon" %}
    {% content_for 'block', type: "text", id: "title" %}
  </div>
  <div class="nov-accordion__content">
    <div class="block color-text position-relative">
      {% content_for 'block', type: "text", id: "content" %}
    </div>
  </div>
</div>

