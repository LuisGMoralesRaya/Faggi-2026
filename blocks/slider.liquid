{%- liquid
  assign bst = block.settings
-%}
{%- style -%}
  #block-{{ block.id }} .slider-item-content {
    border-radius: {{ bst.item_corner }}px;
    overflow: hidden;
    transform: translateZ(0);
    {% if bst.show_item_boxshadow and bst.show_item_boxshadow_when_hover == false %}
      box-shadow: 5px 5px 20px rgba(0,0,0, 0.1);
    {% endif %}
  }
  {% if bst.show_item_boxshadow %}
    #block-{{ block.id }} .slick-list {
      margin-block: -25px;
      padding-block: 25px;
    }
  {% endif %}
  {% if bst.show_item_boxshadow and bst.show_item_boxshadow_when_hover %}
    #block-{{ block.id }} .slider-item-content:hover {
      box-shadow: 10px 10px 25px rgba(0,0,0, 0.1);
    }
  {% endif %}
  
  {% if bst.show_nav %}
    #block-{{ block.id }} .slick-arrow {
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      --slider-arrow-color: {{ bst.slider_arrow_color }};
      --slider-arrow-color-act: {{ bst.slider_arrow_color_act }};
    }
  {% endif %}

{%- endstyle -%}

<div id="block-{{ block.id }}" class="theme-blocks-item slider-block" data-section-id="{{ section.id }}" data-section-type="nov-slick" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;">
  <div class="nov-slick-carousel row spacing-{{ bst.spacing }} spacing-md-{{ bst.spacing_md }}"
    data-autoplay="{{ bst.autoplay }}" 
    data-loop="{{ bst.loop }}"
    data-dots="{{ bst.show_dots }}"
    data-nav="{{ bst.show_nav }}"
    data-row_mobile="1"
    data-items_xxl="{{ bst.xxl }}"
    data-items_xl="{{ bst.xl }}"
    data-items_lg="{{ bst.lg }}"
    data-items_md="{{ bst.md }}"
    data-items_sm="{{ bst.sm }}"
    data-items_xs="{{ bst.xs }}"
    data-speed="700">
      {% content_for 'blocks' %}
  </div>
</div>
{% schema %}
  {
    "name": "Vinova Slider",
    "class": "section-slider",
    "blocks": [
      {
        "type": "_slider_item"
      }
    ],
    "settings": [
      {
        "type": "header",
        "content": "Item Style"
      },
      {
        "type": "range",
        "id": "item_corner",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "label": "Corner radius",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "show_item_boxshadow",
        "label": "Show box shadow",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_item_boxshadow_when_hover",
        "label": "Show box shadow when hover",
        "default": false,
        "visible_if": "{{ block.settings.show_item_boxshadow == true }}"
      },
      {
        "type": "header",
        "content": "Slider Settings"
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop",
        "default": true
      },
      {
        "type":  "header",
        "content": "Item Per Row"
      },
      {
        "type": "range",
        "id": "xxl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Desktop",
        "default": 3,
        "info": "Breakpoint 1441px"
      },
      {
        "type": "range",
        "id": "xl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large laptop",
        "default": 3,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "range",
        "id": "lg",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Laptop",
        "default": 3,
        "info": "Breakpoint 992px"
      },
      {
        "type": "range",
        "id": "md",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Tablet",
        "default": 3,
        "info": "Breakpoint 768px"
      },
      {
        "type": "range",
        "id": "sm",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large mobile",
        "default": 2,
        "info": "Breakpoint 576px"
      },
      {
        "type": "range",
        "id": "xs",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile",
        "default": 2
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 0,
        "max": 70,
        "step": 5,
        "unit": "px",
        "label": "Spacing item",
        "default": 30,
        "info": "Choose the spacing between items (px)"
      },
      {
        "type": "range",
        "id": "spacing_md",
        "min": 0,
        "max": 70,
        "step": 5,
        "unit": "px",
        "label": "Spacing item tablet",
        "default": 30,
        "info": "Choose the spacing between items (px)"
      },
      {
        "type": "header",
        "content": "Dots Slider"
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dots",
        "default": false
      },
      {
        "type": "select",
        "id": "dots_color",
        "label": "Dots color",
        "default": "dots_on_light",
        "options": [
          {"value": "dots_on_light","label": "Dots on light background"},
          {"value": "dots_on_dark","label": "Dots on dark background"}
        ],
        "visible_if": "{{ block.settings.show_dots == true }}"
      },
      {
        "type": "header",
        "content": "Arrow Slider"
      },
      {
        "type": "checkbox",
        "id": "show_nav",
        "label": "Show prev/next arrow",
        "default": true
      },
      {
        "type": "color",
        "id": "slider_arrow_color",
        "label": "Color",
        "default": "#222",
        "visible_if": "{{ block.settings.show_nav == true }}"
      },
      {
        "type": "color",
        "id": "slider_arrow_color_act",
        "label": "Color hover",
        "default": "#666",
        "visible_if": "{{ block.settings.show_nav == true }}"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Slider"
      }
    ]
  }
{% endschema %}
