
{%- liquid
  assign bst = block.settings
  assign aspect = bst.aspect
  if aspect == 'custom'
    assign aspect = bst.aspect_custom
  endif
  assign class = 'no-ef'
  if bst.img_loading_animation
    assign class = ''
  endif

  assign style_width = ''
  assign style_height = ''
  assign wu = bst.image_width_unit
  assign hu = bst.image_height_unit

  if bst.width_custom
    assign style_width = '--image-width:' | append: bst.image_width | append: wu | append: ';'
  endif
  if bst.height_custom
    assign style_height = '--image-height:' | append: bst.image_height | append: hu | append: ';--image-height-xl:' | append: bst.image_height_xl | append: hu | append: ';--image-height-lg:' | append: bst.image_height_lg | append: hu | append: ';--image-height-md:' | append: bst.image_height_md | append: hu | append: ';--image-height-sm:' | append: bst.image_height_sm | append: hu | append: ';--image-height-xs:' | append: bst.image_height_xs | append: hu | append: ';'
  endif

  assign style_mt = '--mt-xl: ' | append: bst.mt_xl | append: 'px;--mt-lg: ' | append: bst.mt_lg | append: 'px;--mt-md: ' | append: bst.mt_md | append: 'px;--mt-sm: ' | append: bst.mt_sm | append: 'px;'
  assign style_mb = '--mb-xl: ' | append: bst.mb_xl | append: 'px;--mb-lg: ' | append: bst.mb_lg | append: 'px;--mb-md: ' | append: bst.mb_md | append: 'px;--mb-sm: ' | append: bst.mb_sm | append: 'px;'

  assign style_object_fit = '--object-fit: ' | append: bst.image_object_fit | append: ';'
  assign style_radius = '--image-radius: ' | append: bst.image_radius | append: 'px;'

  assign image_style = style_width | append: style_height | append: style_object_fit | append: style_radius | append: style_mt | append: style_mb
-%}

<div class="theme-blocks-item image-block position-relative{% if bst.width_custom %} custom-width align-{{ bst.align }}{% endif %}{% if bst.height_custom %} custom-height{% endif %}{% if bst.width_custom == false %} w-100{% endif %}" style="{{ image_style }}">
  {% if bst.link != blank %}
    <a href="{{ bst.link }}" class="d-block w-100">
  {% endif %}
  {% if bst.image != blank %}
    <div class="image-wrapper position-relative {{ bst.img_animation }}">
      {% render 'nov-aspect-image', image: bst.image, aspect: aspect, class: class %}
    </div>
  {% else %}
    <div class="placeholder-image">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {% endif %}
  {% if bst.link != blank %}
    </a>
  {% endif %}
  {% for i in (1..2) %}
    {% assign pattern_image_id = 'pattern_image' | append: i %}
    {% assign pattern_image_animation_id = 'pattern_image_animation' | append: i %}
    {% assign pattern_position_id = 'pattern_position' | append: i %}
    {% assign pattern_position_horizontal_id = 'pattern_position_horizontal' | append: i %}
    {% assign pattern_position_vertical_id = 'pattern_position_vertical' | append: i %}
    {% assign pattern_width_id = 'pattern_width' | append: i %}
    {% assign pattern_index_id = 'pattern_index' | append: i %}
    {% if bst[pattern_image_id] != blank %}
      <div class="pattern-image position-absolute {{ bst[pattern_position_id] }}" style="--horizontal: {{ bst[pattern_position_horizontal_id] }}%;--vertical: {{ bst[pattern_position_vertical_id] }}%; width: {{ bst[pattern_width_id] }}%;{% if bst[pattern_index_id] == 'up' %} z-index: 2;{% endif %}">
        {% if bst[pattern_image_animation_id] %}
          <div class="img_animate">
            <div class="layer" data-depth="{{ forloop.index | plus: 5 | times: 0.1 }}">
              {% render 'nov-aspect-image', image: bst[pattern_image_id], class: 'no-ef' %}
            </div>
          </div>
        {% else %}
          {% render 'nov-aspect-image', image: bst[pattern_image_id], class: 'no-ef' %}
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
  {% if bst.content %}
    <div class="img-blocks-content position-absolute {{ bst.content_position }}{% if bst.show_when_hover_image %} show-when-hover-image{% endif %}" style="--horizontal: {{ bst.content_position_horizontal }}%;--vertical: {{ bst.content_position_vertical }}%; width: {{ bst.content_width }}%;">
      {% content_for 'blocks' %}
    </div>
  {% endif %}
</div>

{% schema %}
  {
    "name": "Image",
    "tag": null,
    "blocks": [
      {
        "type": "text"
      },
      {
        "type": "button"
      },
      {
        "type": "icon"
      },
      {
        "type": "@app"
      }
    ],
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      },
      {
        "type": "header",
        "content": "Width"
      },
      {
        "type": "checkbox",
        "id": "width_custom",
        "label": "Width custom",
        "default": false,
        "info": "Enable to use custom width"
      },
      {
        "type": "select",
        "id": "image_width_unit",
        "label": "Image width unit",
        "options": [
          { "value": "px", "label": "px" },
          { "value": "%", "label": "%" }
        ],
        "default": "%",
        "visible_if": "{{ block.settings.width_custom == true }}"
      },
      {
        "type": "number",
        "id": "image_width",
        "label": "Image width",
        "default": 100,
        "visible_if": "{{ block.settings.width_custom == true }}"
      },
      {
        "type": "text_alignment",
        "id": "align",
        "label": "Alignment",
        "default": "left",
        "visible_if": "{{ block.settings.width_custom == true }}"
      },
      {
        "type": "header",
        "content": "Height"
      },
      {
        "type": "checkbox",
        "id": "height_custom",
        "label": "Height custom",
        "default": false,
        "info": "Enable to use custom height"
      },
      {
        "type": "select",
        "id": "image_height_unit",
        "label": "Image height unit",
        "options": [
          { "value": "px", "label": "px" },
          { "value": "%", "label": "%" }
        ],
        "default": "%",
        "visible_if": "{{ block.settings.height_custom == true }}"
      },
      {
        "type": "number",
        "id": "image_height",
        "label": "Height default",
        "default": 100,
        "visible_if": "{{ block.settings.height_custom == true }}"
      },
      {
        "type": "number",
        "id": "image_height_xl",
        "label": "Height large laptop",
        "default": 100,
        "info": "Breakpoint: 1200px",
        "visible_if": "{{ block.settings.height_custom == true }}"
      },
      {
        "type": "number",
        "id": "image_height_lg",
        "label": "Height laptop",
        "default": 100,
        "info": "Breakpoint: 992px",
        "visible_if": "{{ block.settings.height_custom == true }}"
      },
      {
        "type": "number",
        "id": "image_height_md",
        "label": "Height tablet",
        "default": 100,
        "info": "Breakpoint: 768px",
        "visible_if": "{{ block.settings.height_custom == true }}"
      },
      {
        "type": "number",
        "id": "image_height_sm",
        "label": "Height large mobile",
        "default": 100,
        "info": "Breakpoint: 576px",
        "visible_if": "{{ block.settings.height_custom == true }}"
      },
      {
        "type": "number",
        "id": "image_height_xs",
        "label": "Height mobile",
        "default": 100,
        "visible_if": "{{ block.settings.height_custom == true }}"
      },
      {
        "type": "header",
        "content": "Image Config"
      },
      
      {
        "type": "number",
        "id": "image_radius",
        "label": "Image radius",
        "default": 5,
        "info": "Unit: px"
      },
      {
        "type": "select",
        "id": "image_object_fit",
        "label": "Image object fit",
        "options": [
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" },
          { "value": "None", "label": "None" }
        ],
        "default": "cover"
      },
      {
        "type": "select",
        "id": "aspect",
        "label": "Aspect ratio image",
        "default": "auto",
        "options": [
          {"value": "auto", "label": "auto"},
          {"value": "11", "label": "1/1"},
          {"value": "34", "label": "3/4"},
          {"value": "43", "label": "4/3"},
          {"value": "custom", "label": "Custom"}
        ],
        "visible_if": "{{ block.settings.height_custom == false and block.settings.width_custom == false }}"
      },
      {
        "type": "range",
        "id": "aspect_custom",
        "label": "Aspect ratio custom",
        "default": 100,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "visible_if": "{{ block.settings.aspect == 'custom' }}"
      },
      {
        "type": "select",
        "id": "img_animation",
        "label": "Image animation when hover",
        "default": "nov-sh-image-1",
        "options": [
          {"value": "nov-sh-image-1","label": "Style 1"},
          {"value": "nov-sh-image-2","label": "Style 2"},
          {"value": "nov-sh-image-3","label": "Style 3"},
          {"value": "nov-sh-image-4","label": "Style 4"},
          {"value": "nov-sh-image-5","label": "Style 5"},
          {"value": "nov-sh-image-6","label": "Style 6"},
          {"value": "nov-sh-image-none","label": "None"}
        ]
      },
      {
        "type": "checkbox",
        "id": "img_loading_animation",
        "label": "Image loading animation",
        "default": true
      },
      {
        "type": "header",
        "content": "Pattern 1"
      },
      {
        "type": "image_picker",
        "id": "pattern_image1",
        "label": "Pattern image"
      },
      {
        "type": "checkbox",
        "id": "pattern_image_animation1",
        "label": "Pattern image animation",
        "default": false,
        "info": "Enable to show pattern image animation",
        "visible_if": "{{ block.settings.pattern_image1 != blank }}"
      },
      {
        "type": "select",
        "id": "pattern_index1",
        "label": "Pattern index",
        "default": "up",
        "options": [
          {"value": "up", "label": "Up" },
          {"value": "down", "label": "Down"}
        ],
        "visible_if": "{{ block.settings.pattern_image1 != blank }}"
      },
      {
        "type": "select",
        "id": "pattern_position1",
        "label": "Pattern position",
        "default": "left-center",
        "options": [
          {"value": "left-top", "label": "Left top" },
          {"value": "left-center", "label": "Left center"},
          {"value": "left-bottom", "label": "Left bottom"},
          {"value": "right-top", "label": "Right top" },
          {"value": "right-center", "label": "Right center"},
          {"value": "right-bottom", "label": "Right bottom"},
          {"value": "top-center", "label": "Top center"},
          {"value": "center-center", "label": "Middle center"},
          {"value": "bottom-center", "label": "Bottom center"}
        ],
        "visible_if": "{{ block.settings.pattern_image1 != blank }}"
      },
      {
        "type": "range",
        "id": "pattern_position_horizontal1",
        "label": "Pattern position horizontal",
        "default": 5,
        "min": -40,
        "max": 60,
        "step": 1,
        "unit": "%",
        "visible_if": "{{ block.settings.pattern_image1 != blank }}"
      },
      {
        "type": "range",
        "id": "pattern_position_vertical1",
        "label": "Pattern position vertical",
        "default": 5,
        "min": -40,
        "max": 60,
        "step": 1,
        "unit": "%",
        "visible_if": "{{ block.settings.pattern_image1 != blank }}"
      },
      {
        "type": "range",
        "id": "pattern_width1",
        "label": "Pattern width",
        "default": 20,
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "%",
        "visible_if": "{{ block.settings.pattern_image1 != blank }}"
      },
      {
        "type": "header",
        "content": "Pattern 2"
      },
      {
        "type": "image_picker",
        "id": "pattern_image2",
        "label": "Pattern image"
      },
      {
        "type": "checkbox",
        "id": "pattern_image_animation2",
        "label": "Pattern image animation",
        "default": false,
        "info": "Enable to show pattern image animation",
        "visible_if": "{{ block.settings.pattern_image2 != blank }}"
      },
      {
        "type": "select",
        "id": "pattern_index2",
        "label": "Pattern index",
        "default": "up",
        "options": [
          {"value": "up", "label": "Up" },
          {"value": "down", "label": "Down"}
        ],
        "visible_if": "{{ block.settings.pattern_image2 != blank }}"
      },
      {
        "type": "select",
        "id": "pattern_position2",
        "label": "Pattern position",
        "default": "left-center",
        "options": [
          {"value": "left-top", "label": "Left top" },
          {"value": "left-center", "label": "Left center"},
          {"value": "left-bottom", "label": "Left bottom"},
          {"value": "right-top", "label": "Right top" },
          {"value": "right-center", "label": "Right center"},
          {"value": "right-bottom", "label": "Right bottom"},
          {"value": "top-center", "label": "Top center"},
          {"value": "center-center", "label": "Middle center"},
          {"value": "bottom-center", "label": "Bottom center"}
        ],
        "visible_if": "{{ block.settings.pattern_image2 != blank }}"
      },
      {
        "type": "range",
        "id": "pattern_position_horizontal2",
        "label": "Pattern position horizontal",
        "default": 5,
        "min": -40,
        "max": 60,
        "step": 1,
        "unit": "%",
        "visible_if": "{{ block.settings.pattern_image2 != blank }}"
      },
      {
        "type": "range",
        "id": "pattern_position_vertical2",
        "label": "Pattern position vertical",
        "default": 5,
        "min": -40,
        "max": 60,
        "step": 1,
        "unit": "%",
        "visible_if": "{{ block.settings.pattern_image2 != blank }}"
      },
      {
        "type": "range",
        "id": "pattern_width2",
        "label": "Pattern width",
        "default": 20,
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "%",
        "visible_if": "{{ block.settings.pattern_image2 != blank }}"
      },
      {
        "type": "header",
        "content": "Content Style"
      },
      {
        "type": "checkbox",
        "id": "content",
        "label": "Content",
        "default": false,
        "info": "Enable to show content"
      },
      {
        "type": "checkbox",
        "id": "show_when_hover_image",
        "label": "Show when hover image",
        "default": false,
        "info": "Enable to show content when hover image",
        "visible_if": "{{ block.settings.content == true }}"
      },
      {
        "type": "select",
        "id": "content_position",
        "label": "Content position",
        "default": "left-center",
        "options": [
          {"value": "left-top", "label": "Left top" },
          {"value": "left-center", "label": "Left center"},
          {"value": "left-bottom", "label": "Left bottom"},
          {"value": "right-top", "label": "Right top" },
          {"value": "right-center", "label": "Right center"},
          {"value": "right-bottom", "label": "Right bottom"},
          {"value": "top-center", "label": "Top center"},
          {"value": "center-center", "label": "Middle center"},
          {"value": "bottom-center", "label": "Bottom center"}
        ],
        "visible_if": "{{ block.settings.content == true }}"
      },
      {
        "type": "range",
        "id": "content_position_horizontal",
        "label": "Position horizontal",
        "default": 5,
        "min": -40,
        "max": 60,
        "step": 1,
        "unit": "%",
        "visible_if": "{{ block.settings.content == true }}"
      },
      {
        "type": "range",
        "id": "content_position_vertical",
        "label": "Position vertical",
        "default": 50,
        "min": -40,
        "max": 60,
        "step": 1,
        "unit": "%",
        "visible_if": "{{ block.settings.content == true }}"
      },
      {
        "type": "range",
        "id": "content_width",
        "label": "Width",
        "default": 100,
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "%",
        "visible_if": "{{ block.settings.content == true }}"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Image"
      }
    ]
  }
{% endschema %}