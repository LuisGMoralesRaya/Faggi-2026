{%- assign bst = block.settings -%}
<div class="theme-blocks-item product-list-block" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;" data-section-id="{{ section.id }}" data-section-type="nov-swiper">
  <div class="grid--view-items{% if bst.layout_type == 'slider' %} nov-swiper-carousel swiper{% if bst.right_overflow %} overflow-right{% endif %}{% endif %}"
    {% if bst.layout_type == 'slider' %}
      data-autoplay="false" 
      data-autoplayTimeout="6000"
      data-loop="false"
      data-row="{{ bst.row_number }}"
      data-row_mobile="{{ bst.row_mobile }}"
      data-items_xxl="{{ bst.xxl }}"
      data-items_xl="{{ bst.xl }}"
      data-items_lg="{{ bst.lg }}"
      data-items_md="{{ bst.md }}"
      data-items_sm="{{ bst.sm }}"
      data-items_xs="{{ bst.xs }}"
      data-spacing="{{ bst.spacing }}"
      data-spacing_mobile="15"
    {% endif %}
  >
    <div class="{% if bst.layout_type == 'slider' %}swiper-wrapper{% else %}grid-wrapper row{% endif %}">
      {% for product in collections[bst.collection].products limit: bst.limit %}
        <div class="{% if bst.layout_type == 'slider' %}swiper-slide{% else %}{% render 'number-to-col', xxl: bst.xxl, xl: bst.xl, lg: bst.lg, md: bst.md, sm: bst.sm, xs: bst.xs  %}{% endif %} item">
          {% render 'product-grid-item-style-1', product: product, section_id: section.id %}
        </div>
      {% else %}
        {%- for i in (1..6) -%}
          {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
          <div class="{% if bst.layout_type == 'slider' %}swiper-slide{% else %}{% render 'number-to-col', xxl: bst.xxl, xl: bst.xl, lg: bst.lg, md: bst.md, sm: bst.sm, xs: bst.xs %}{% endif %} item">
            {{ 'product-apparel-' | append: current | placeholder_svg_tag : 'placeholder-svg' }}
          </div>
        {%- endfor -%}
      {% endfor %}
    </div>
    {% if bst.show_pagination_progress %}
      <div class="swiper-scrollbar mt-80 mt-md-40 position-static"></div>
    {% endif %}
    {% if bst.layout_type == 'slider' %}
      {% if bst.show_nav or bst.show_dots %}
        <div class="d-flex align-items-center mt-60">
          {% if bst.show_nav %}
            <div class="nav-arrow nav-prev pointer">
              {% render 'icon-arrow-left' %}
            </div>
          {% endif %}
          {% if bst.show_dots %}
            <div class="swiper-pagination"></div>
          {% endif %}
          {% if bst.show_nav %}
            <div class="nav-arrow nav-next pointer">
              {% render 'icon-arrow-right' %}
            </div>
          {% endif %}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
  
{% schema %}
  {
    "name": "Product List",
    "tag": null,
    "settings": [
      {
        "type":  "header",
        "content": "Block Product"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
      {
        "type": "range",
        "id": "limit",
        "min": 4,
        "max": 30,
        "step": 1,
        "label": "Limit",
        "default": 10,
        "info": "Select number limit products"
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 0,
        "max": 70,
        "step": 5,
        "unit": "px",
        "label": "Spacing item",
        "default": 30
      },
      {
        "type": "header",
        "content": "Layout Type"
      },
      {
        "type": "select",
        "id": "layout_type",
        "label": "Layout type",
        "default": "slider",
        "options": [
          { "value": "slider", "label": "Slider" },
          { "value": "grid", "label": "Grid" }
        ]
      },
      {
        "type": "range",
        "id": "row_number",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Number row",
        "default": 1,
        "visible_if": "{{ block.settings.layout_type == 'slider' }}"
      },
      {
        "type": "range",
        "id": "row_mobile",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Number row mobile",
        "default": 1,
        "visible_if": "{{ block.settings.layout_type == 'slider' }}"
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dots",
        "default": false,
        "visible_if": "{{ block.settings.layout_type == 'slider' }}"
      },
      {
        "type": "select",
        "id": "dots_color",
        "label": "Dots color",
        "default": "dots_on_light",
        "options": [
          {"value": "dots_on_light","label": "Dots on light background"},
          {"value": "dots_on_dark","label": "Dots on dark background"}
        ],
        "visible_if": "{{ block.settings.show_dots and block.settings.layout_type == 'slider' }}"
      },
      {
        "type": "checkbox",
        "id": "show_nav",
        "label": "Show prev/next arrow",
        "default": false,
        "visible_if": "{{ block.settings.layout_type == 'slider' }}"
      },
      {
        "type": "color",
        "id": "slider_arrow_color",
        "label": "Color",
        "default": "#222",
        "visible_if": "{{ block.settings.show_nav == true and block.settings.layout_type == 'slider' }}"
      },
      {
        "type": "color",
        "id": "slider_arrow_color_act",
        "label": "Color hover",
        "default": "#666",
        "visible_if": "{{ block.settings.show_nav == true and block.settings.layout_type == 'slider' }}"
      },
      {
        "type": "checkbox",
        "id": "show_pagination_progress",
        "label": "Show pagination progress",
        "visible_if": "{{ block.settings.layout_type == 'slider' }}"
      },
      {
        "type": "color",
        "id": "pagination_progress_bg",
        "label": "Background pagination progress",
        "default": "#eaeaee",
        "visible_if": "{{ block.settings.show_pagination_progress and block.settings.layout_type == 'slider' }}"
      },
      {
        "type": "color",
        "id": "progress_bg",
        "label": "Background progress",
        "default": "#000",
        "visible_if": "{{ block.settings.show_pagination_progress and block.settings.layout_type == 'slider' }}"
      },
      {
        "type": "checkbox",
        "id": "right_overflow",
        "label": "Right overflow",
        "default": false,
        "info": "Enable to show the right overflow",
        "visible_if": "{{ block.settings.layout_type == 'slider' }}"
      },
      {
        "type":  "header",
        "content": "Product Item Per Row"
      },
      {
        "type": "range",
        "id": "xxl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Desktop",
        "default": 3,
        "info": "Breakpoint 1441px"
      },
      {
        "type": "range",
        "id": "xl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large laptop",
        "default": 3,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "range",
        "id": "lg",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Laptop",
        "default": 3,
        "info": "Breakpoint 992px"
      },
      {
        "type": "range",
        "id": "md",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Tablet",
        "default": 3,
        "info": "Breakpoint 768px"
      },
      {
        "type": "range",
        "id": "sm",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large mobile",
        "default": 2,
        "info": "Breakpoint 576px"
      },
      {
        "type": "range",
        "id": "xs",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile",
        "default": 2,
        "info": "Breakpoint"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Product List"
      }
    ]
  }
{% endschema %}