{%- assign bst = block.settings -%}
{% style %}
  #block-{{ block.id }} {
    border-radius: {{ bst.radius }}px;
    overflow: hidden;
    transform: translateZ(0);
  }
  {%- if bst.img_cover != blank -%}
    #block-{{ block.id }} .bg-video__cover {
      top:  0;
      left: 0;
      background: url("{{ bst.img_cover | image_url: width: 2560 }}") center;
      background-size: cover;
    }
  {%- endif -%}
  {% if bst.enable_mh %}
    #block-{{ block.id }} video, #block-{{ block.id }} .img-cover {
      height: 100% !important;
    }
    #block-{{ block.id }} video {
      height: {{ bst.mh }}px !important;
    }
    @media(min-width: 768px) {
      #block-{{ block.id }} video {
        height: {{ bst.mh_md }}px !important;
      }
    }
    @media(min-width: 1200px) {
      #block-{{ block.id }} video {
        height: {{ bst.mh_xl }}px !important;
      }
    }
    @media(min-width: 1441px) {
      #block-{{ block.id }} video {
        height: {{ bst.mh_xxl }}px !important;
      }
    }
  {% endif %}
{% endstyle %}
<div id="block-{{ block.id }}" class="theme-blocks-item video-block color-{{ bst.btn_play_color }} {{ bst.btn_play_type_color }} position-relative" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;">
  {% if bst.video != blank %}
    {{ bst.video | video_tag: image_size: '1100x', autoplay: bst.autoplay, loop: true, controls: bst.controls, muted: bst.muted, data-id: block.id, data-alt: shop.name, style: "width: 100%;max-width: 100%;height: auto;object-fit: cover; display: block" }}
    {% if bst.img_cover != blank %}
      <div class="bg-video__cover position-absolute w-100 h-100" data-id="{{ block.id }}"></div>
    {% endif %}
  {% endif %}
  {% if bst.img_cover != blank and bst.show_video_popup and bst.video == blank %}
    <img src="{{ bst.img_cover | image_url: width: 180 }}" data-src="{{ bst.img_cover | image_url: width: 1920 }}" class="img-cover w-100 lazyload" alt="{{ bst.img_cover.alt }}" width="{{ bst.img_cover.width }}" height="{{ bst.img_cover.height }}" style="object-fit: cover; height: auto;" loading="lazy">
  {% endif %}
  <div class="block-text position-absolute center-center text-center" data-id="{{ block.id }}">
    {% content_for 'blocks' %}
    {% if bst.video != blank or bst.show_video_popup %}
      <div class="block-icon__play d-flex justify-content-center">
        {% if bst.video != blank %}
          {% if bst.img_cover != blank or bst.autoplay == false %}
            <div class="btn-video__play" data-id="{{ block.id }}">
              {% render 'icon-caret-right' %}
            </div>
          {% endif %}
        {% endif %}
        {% if bst.show_video_popup %}
          <div class="icon_play" data-toggle="modal" data-target="#ModalVideo" data-src="{% if bst.video_url.type == "youtube"  %}https://www.youtube.com/embed/{{ bst.video_url.id }}?rel=0&showinfo=0&vq=720{% endif %}{% if bst.video_url.type == "vimeo" %}//player.vimeo.com/video/{{ bst.video_url.id }}?byline=0&portrait=0&badge=0{% endif %}">
            {% render 'icon-caret-right' %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
  {% if bst.video == blank and bst.show_video_popup == false %}
    {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}
    <div class="block-text text-center position-absolute center-center">
      <div class="block-icon__play d-flex justify-content-center">
        <div class="btn-video__play" data-id="{{ block.id }}">
          {% render 'icon-caret-right' %}
        </div>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
  {
    "name": "Video",
    "tag": null,
    "blocks": [
      {
        "type": "text"
      },
      {
        "type": "button"
      },
      {
        "type": "@app"
      }
    ],
    "settings": [
      {
        "type": "header",
        "content": "Video Default"
      },
      {
        "type": "video",
        "id": "video",
        "label": "Video"
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": false,
        "visible_if": "{{ block.settings.video != blank }}"
      },
      {
        "type": "checkbox",
        "id": "muted",
        "label": "Muted",
        "default": true,
        "visible_if": "{{ block.settings.video != blank }}"
      },
      {
        "type": "checkbox",
        "id": "controls",
        "label": "Controls",
        "default": false,
        "visible_if": "{{ block.settings.video != blank }}"
      },
      {
        "type": "header",
        "content": "Video Popup"
      },
      {
        "type": "checkbox",
        "id": "show_video_popup",
        "label": "Enable video popup",
        "default": false
      },
      {
        "type": "video_url",
        "id": "video_url",
        "label": "Video popup",
        "accept": ["youtube", "vimeo"],
        "info": "Only For Youtube And Vimeo"
      },
      {
        "type": "header",
        "content": "Button Play"
      },
      {
        "type": "color_scheme",
        "id": "btn_play_color",
        "label": "Color button play",
        "default": "background-1"
      },
      {
        "type": "select",
        "id": "btn_play_type_color",
        "label": "Color button play type",
        "options": [
          {
            "value": "btn-primary",
            "label": "Primary"
          },
          {
            "value": "btn-secondary",
            "label": "Secondary"
          }
        ],
        "default": "btn-primary"
      },
      {
        "type": "header",
        "content": "Background cover"
      },
      {
        "type": "image_picker",
        "id": "img_cover",
        "label": "Background cover"
      },
      {
        "type": "header",
        "content": "Corner radius"
      },
      {
        "type": "range",
        "id": "radius",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Corner radius",
        "default": 5
      },
      {
        "type": "header",
        "content": "Video Height"
      },
      {
        "type": "checkbox",
        "id": "enable_mh",
        "label": "Enable custom height",
        "default": false
      },
      {
        "type": "number",
        "id": "mh_xxl",
        "label": "Extra large laptop",
        "default": 600,
        "info": "Breakpoint 1441px",
        "visible_if": "{{ block.settings.enable_mh == true }}"
      },
      {
        "type": "number",
        "id": "mh_xl",
        "label": "Large laptop",
        "default": 400,
        "info": "Breakpoint 1200px",
        "visible_if": "{{ block.settings.enable_mh == true }}"
      },
      {
        "type": "number",
        "id": "mh_md",
        "label": "Tablet",
        "default": 400,
        "info": "Breakpoint 768px",
        "visible_if": "{{ block.settings.enable_mh == true }}"
      },
      {
        "type": "number",
        "id": "mh",
        "label": "Mobile",
        "default": 400,
        "visible_if": "{{ block.settings.enable_mh == true }}"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Video"
      }
    ]
  }
{% endschema %}