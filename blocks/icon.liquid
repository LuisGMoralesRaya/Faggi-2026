{%- assign bst = block.settings -%}
<div class="theme-blocks-item icon-block" style="--color-icon: {{ bst.icon_color }}; --color-icon-hover: {{ bst.icon_color_hover }}; --bg-icon-hover: {{ bst.background_color_hover }};--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;">
  <div class="icon-block-wrapper d-flex align-items-center justify-content-center overflow_hidden{% if bst.hover_effect %} hover-effect{% endif %}" style="width: {{ bst.background_size }}px;min-width: {{ bst.background_size }}px; height: {{ bst.background_size }}px; border-radius: {{ bst.border_radius }}px; background-color: {{ bst.background_color }};">
    <div class="icon-content" style="width: {{ bst.icon_size }}px;">
      {%- if bst.icon != blank -%}
        {% render 'nov-aspect-image', image: bst.icon, aspect: bst.aspect, class: 'no-ef' %}
      {%- elsif bst.icon_svg != blank -%}
        {{ bst.icon_svg }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icon",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "html",
      "id": "icon_svg",
      "label": "Icon SVG",
      "info": "Replace fill and stroke color with 'currentColor' to use custom color"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#444444",
      "visible_if": "{{ block.settings.icon_svg != blank }}"
    },
    {
      "type": "color",
      "id": "icon_color_hover",
      "label": "Icon color hover",
      "default": "#000000",
      "visible_if": "{{ block.settings.icon_svg != blank }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Icon size",
      "default": 30
    },
    {
      "type": "select",
      "id": "aspect",
      "label": "Aspect ratio",
      "default": "auto",
      "options": [
        {"value": "auto", "label": "auto"},
        {"value": "11", "label": "1/1"},
        {"value": "34", "label": "3/4"},
        {"value": "43", "label": "4/3"}
      ],
      "visible_if": "{{ block.settings.icon_svg == blank }}"
    },
    {
      "type": "number",
      "id": "background_size",
      "label": "Background size",
      "default": 50,
      "info": "Unit: px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "alpha": true,
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color_hover",
      "label": "Background color hover",
      "alpha": true,
      "default": "#000000"
    },
    {
      "type": "number",
      "id": "border_radius",
      "label": "Border radius",
      "default": 10,
      "info": "Unit: px"
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Hover effect",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing Top (px)"
    },
    {
      "type": "number",
      "id": "mt_xl",
      "label": "Large laptop",
      "default": 0,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mt_lg",
      "label": "Laptop",
      "default": 0,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mt_md",
      "label": "Tablet",
      "default": 0,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mt_sm",
      "label": "Mobile",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing Bottom (px)"
    },
    {
      "type": "number",
      "id": "mb_xl",
      "label": "Large laptop",
      "default": 0,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mb_lg",
      "label": "Laptop",
      "default": 0,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mb_md",
      "label": "Tablet",
      "default": 0,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mb_sm",
      "label": "Mobile",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Icon"
    }
  ]
}
{% endschema %}