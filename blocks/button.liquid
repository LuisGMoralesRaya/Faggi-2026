{%- assign bst = block.settings -%}
<div class="theme-blocks-item button-block color-{{ bst.color_scheme }} text-{{ bst.text_alignment }}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;{% if bst.btn_type == 'link' %}--color-link: {{ bst.link_color }};--color-hover: {{ bst.link_color_hover }}{% endif %}">
  <a href="{{ bst.link | default: '#' }}" class="{% if bst.btn_type == 'link' %}link d-inline-flex align-items-center fs-{{ bst.link_fs }} {{ bst.link_fw }}{% else %}btn {{ bst.button_size }} {{ bst.button_type_color }}{% if bst.button_full_width %} w-100{% endif %}{% endif %}">
  <span>{{ bst.button_label }}</span>
  {% if bst.show_arrow %}
    <i class="zmdi zmdi-long-arrow-right"></i>
  {% endif %}
  </a>
</div>
  
{% schema %}
  {
    "name": "Button",
    "tag": null,
    "settings": [
      {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Shop Now"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      },
      {
        "type": "checkbox",
        "id": "show_arrow",
        "label": "Show arrow",
        "default": false
      },
      {
        "type": "select",
        "id": "btn_type",
        "label": "Button type",
        "options": [
          { "value": "btn", "label": "Button" },
          { "value": "link", "label": "Link" }
        ],
        "default": "btn"
      },
      {
        "type": "number",
        "id": "link_fs",
        "label": "Font size",
        "default": 14,
        "visible_if": "{{ block.settings.btn_type == 'link' }}"
      },
      {
        "type": "select",
        "id": "link_fw",
        "label": "Font weight",
        "options": [
          {"value": "font-100","label": "Thin - 100"},
          {"value": "font-300","label": "Light - 300"},
          {"value": "font-400","label": "Regular - 400"},
          {"value": "font-500","label": "Medium - 500"},
          {"value": "font-600","label": "SemiBold - 600"},
          {"value": "font-700","label": "Bold - 700"},
          {"value": "font-800","label": "ExtraBold - 800"},
          {"value": "font-900","label": "Black - 900"}
        ],
        "default": "font-400",
        "visible_if": "{{ block.settings.btn_type == 'link' }}"
      },
      {
        "type": "color",
        "id": "link_color",
        "label": "Color",
        "default": "#666",
        "visible_if": "{{ block.settings.btn_type == 'link' }}"
      },
      {
        "type": "color",
        "id": "link_color_hover",
        "label": "Color hover",
        "default": "#000",
        "visible_if": "{{ block.settings.btn_type == 'link' }}"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "background-1",
        "visible_if": "{{ block.settings.btn_type == 'btn' }}"
      },
      {
        "type": "select",
        "id": "button_size",
        "label": "Button size",
        "options": [
          { "value": "btn-normal", "label": "Normal" },
          { "value": "btn-medium", "label": "Medium" },
          { "value": "btn-large", "label": "Large" }
        ],
        "default": "btn-normal",
        "visible_if": "{{ block.settings.btn_type == 'btn' }}"
      },
      {
        "type": "select",
        "id": "button_type_color",
        "label": "Button type color",
        "options": [
          { "value": "btn-primary", "label": "Primary" },
          { "value": "btn-secondary", "label": "Secondary" }
        ],
        "default": "btn-primary",
        "visible_if": "{{ block.settings.btn_type == 'btn' }}"
      },
      {
        "type": "text_alignment",
        "id": "text_alignment",
        "label": "Alignment",
        "default": "left"
      },
      {
        "type": "checkbox",
        "id": "button_full_width",
        "label": "Full width",
        "visible_if": "{{ block.settings.btn_type == 'btn' }}"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Button"
      }
    ]
  }
{% endschema %}