          "type": "faq",
          "settings": {
            "item_title": "¿Cómo debo escribir mi personalización?",
            "color_title": "#232630",
            "fz_title": "16px",
            "item_content": "Escribe nombres, iniciales, fechas y mensajes cortos exactamente como quieres verlos, incluyendo mayúsculas, minúsculas, signos y espacios.",
