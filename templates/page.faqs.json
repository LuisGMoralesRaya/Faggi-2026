          "settings": {
            "item_title": "¿Puedo enviar una pieza como regalo?",
            "color_title": "#232630",
            "fz_title": "16px",
            "item_content": "Sí. Nuestras joyas están pensadas para regalar en cumpleaños, aniversarios, madrinas, nacimientos y momentos cotidianos con significado.",
