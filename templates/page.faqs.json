            "fz_content": "14px",
            "class": ""
          }
        },
        "74d8dd51-2e35-49c0-88df-e1c45645f17c": {
          "type": "faq",
          "settings": {
            "item_title": "¿Qué materiales y acabados puedo esperar?",
            "color_title": "#232630",
            "fz_title": "16px",
            "item_content": "Los detalles varían según la pieza, pero cada diseño busca equilibrar una estática delicada, comodidad al usarla y un acabado pulido ideal para regalar.",
            "color_content": "#232630",
            "fz_content": "14px",
            "class": ""
          }
        },
        "4ee00231-8e56-4c78-abb2-d73e40f1a7ec": {
          "type": "faq",
          "settings": {
            "item_title": "¿Cómo debo cuidar mi joya?",
            "color_title": "#232630",
            "fz_title": "16px",
            "item_content": "Para ayudar a conservar el acabado de tu pieza, guárdala en un lugar seco y evita el contacto directo con agua, perfumes, cremas y productos químicos.",
            "color_content": "#232630",
            "fz_content": "14px",
            "class": ""
          }
        },
