{%- assign sst = section.settings -%}

<section class="faggi-seo-editorial" style="
  padding-top: {{ sst.padding_top }}px;
  padding-bottom: {{ sst.padding_bottom }}px;
  background-color: {{ sst.background_color }};
">
  <div class="{{ sst.container }}">
    {%- if sst.eyebrow != blank -%}
      <p class="faggi-seo-editorial__eyebrow" style="color: {{ sst.eyebrow_color }};">
        {{ sst.eyebrow }}
      </p>
    {%- endif -%}

    {%- if sst.heading != blank -%}
      <h2 class="faggi-seo-editorial__heading" style="color: {{ sst.heading_color }};">
        {{ sst.heading }}
      </h2>
    {%- endif -%}

    {%- if sst.subheading != blank -%}
      <p class="faggi-seo-editorial__subheading" style="color: {{ sst.subheading_color }};">
        {{ sst.subheading }}
      </p>
    {%- endif -%}

    {%- if sst.content != blank -%}
      <div class="faggi-seo-editorial__content rte" style="color: {{ sst.text_color }};">
        {{ sst.content }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="faggi-seo-editorial__features">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <div class="faggi-seo-editorial__feature" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="faggi-seo-editorial__feature-icon">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="faggi-seo-editorial__feature-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="faggi-seo-editorial__feature-desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if sst.cta_label != blank -%}
      <div class="faggi-seo-editorial__cta">
        <a href="{{ sst.cta_link }}" class="btn btn-primary">{{ sst.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Faggi - Bloque Editorial SEO",
  "tag": "section",
  "class": "faggi-seo-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Ceja (eyebrow)",
      "default": "Joyeria Personalizada"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo H2",
      "default": "Joyeria Personalizada con Grabado, Fotos y Charms"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitulo",
      "default": "Piezas unicas hechas a mano para momentos que merecen ser recordados"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Contenido editorial SEO",
      "default": "<p>En Faggi creamos joyeria personalizada que transforma tus emociones en piezas unicas. Desde collares con grabado de texto e iniciales hasta relicarios con fotografia, cada joya se elabora a mano con materiales de alta calidad. Descubre nuestra coleccion de charms personalizados, pulseras grabadas y dijes con significado. Enviamos a toda la Republica Mexicana con envio gratis en compras desde $799 MXN.</p>"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color de la ceja",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del titulo",
      "default": "#1f2937"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color del subtitulo",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Contenedor",
      "options": [
        { "value": "container", "label": "Normal" },
        { "value": "container-fluid", "label": "Ancho completo" }
      ],
      "default": "container"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 120,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 120,
      "step": 10,
      "default": 60
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto del boton CTA"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del boton CTA"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Caracteristica",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icono (emoji o texto corto)",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titulo",
          "default": "Grabado personalizado"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripcion",
          "default": "Texto, iniciales o frases grabadas en tu joya con precision artesanal."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Faggi - Bloque Editorial SEO",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "✍️",
            "title": "Grabado con Texto",
            "description": "Iniciales, nombres, fechas o frases cortas grabadas con precision en tu joya personalizada."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "📷",
            "title": "Grabado con Foto",
            "description": "Relicarios y dijes con tu fotografia favorita grabada en alta resolucion."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "💎",
            "title": "Charms Personalizados",
            "description": "Mas de 40 disenos de charms para crear una pieza unica que te represente."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🎁",
            "title": "Regalo Perfecto",
            "description": "Cada pedido incluye empaque especial. Ideal para cumpleanos, aniversarios y fechas especiales."
          }
        }
      ]
    }
  ]
}
{% endschema %}
