{%- liquid
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}
{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .testimonial-item {
    background: {{ sst.item_bg }};
    border-radius: {{ sst.item_corner }}px;
    padding: 2rem;
  }
  #shopify-section-{{ section.id }} .testimonial-avatar {
    border-radius: {{ sst.item_corner }}px;
  }
  {% if sst.text_mw != blank %}
  	#shopify-section-{{ section.id }} .testimonial-item__quote p {
  		max-width: {{ sst.text_mw }}px;
  		display: inline-block;
  	}
  {% endif %}

  {% if sst.s_star %}
  	#shopify-section-{{ section.id }} .testimonial-rating i.rating {
  		color: {{ sst.color_rating }}
  	}
  {% endif %}

{% endstyle %}

<div class="color-{{ sst.color_section }} {{ bg_class_full }} {{ sst.dots_color }} {{ sst.arrow_color }}" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      <div class="row">
        <div class="col-xl-4 mb-lg-20 {{ sst.heading_alignment }}">
          {% render 'heading-section', sub_position: sst.subheading_position, class: 'mb-0' %}
          {% if sst.show_nav %}
            <div class="d-inline-flex justify-content-center align-items-center mt-35 mt-md-30">
              <div class="nav-arrow nav-prev pointer"></div>
              <div class="nav-arrow nav-next pointer"></div>
            </div>
          {% endif %}
        </div>
        <div class="col-xl-8">
          <div
            class="nov-slick-carousel row spacing-30{% if sst.animate %} wow fadeInRight{% endif %}"
            data-loop="true"
            data-dots="{{ sst.show_dots }}"
            data-nav="{{ sst.show_nav }}"
            data-items_xxl="1"
            data-items_xl="1"
            data-items_lg="1"
            data-items_md="1"
            data-items_sm="1"
            data-items_xs="1"
            data-row="1"
            data-speed="700"
            data-custnav
            data-oneslider="true"
          >
            {% for block in section.blocks %}
              {% assign bst = block.settings %}
              {%- liquid
                case bst.star
                  when 1
                    assign ns = '<i class="rating"></i><i></i><i></i><i></i><i></i>'
                  when 2

                    assign ns = '<i class="rating"></i><i class="rating"></i><i></i><i></i><i></i>'
                  when 3
                    assign ns = '<i class="rating"></i><i class="rating"></i><i class="rating"></i><i></i><i></i>'
                  when 4
                    assign ns = '<i class="rating"></i><i class="rating"></i><i class="rating"></i><i class="rating"></i><i></i>'
                  when 5
                    assign ns = '<i class="rating"></i><i class="rating"></i><i class="rating"></i><i class="rating"></i><i class="rating"></i>'
                endcase
              -%}
              {% if block.type == 'quote' %}
                <div class="sp-item position-relative {% render 'number-to-col', xxl: sst.xxl, xl: sst.xl, lg: sst.lg, md: sst.md, sm: sst.sm, xs: sst.xs  %}">
                  <div class="testimonial-item position-relative">
                    {% if sst.pattern != blank %}
                      <div class="item-pattern position-absolute">
                        {% render 'nov-aspect-image', image: sst.pattern %}
                      </div>
                    {% endif %}
                    <div class="d-sm-flex align-items-center">
                      {% if sst.show_avatar %}
                        <div class="testimonial-avatar overflow_hidden mb-sm-20">
                          {% if bst.avatar != blank %}
                            {% render 'nov-aspect-image', image: bst.avatar %}
                          {% else %}
                            {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                            {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                          {% endif %}
                        </div>
                      {% endif %}
                      <div class="testimonial-item_right">
                        {% if sst.s_star %}
                          <div class="testimonial-rating mb-20 mb-sm-10">{{ ns }}</div>
                        {% endif %}
                        {% if bst.title != blank %}
                          <h2 class="testimonial-title fs-18 mb-15 color-title">{{ bst.title }}</h2>
                        {% endif %}
                        {% if bst.quote != blank %}
                          <div class="testimonial-item__quote fs-20 fs-lg-16 fs-sm-14 font-700 color-title">{{ bst.quote }}</div>
                        {% endif %}
                        {% if bst.name != blank or bst.info != blank %}
                          <div class="d-flex align-items-center mt-30 mt-sm-15">
                            {% if bst.name != blank %}
                              <div class="testimonial-name fs-14 fs-sm-12 font-700 color-title">{{ bst.name }}</div>
                            {% endif %}
                            {% if bst.info != blank %}
                              <div class="testimonial-info fs-14 fs-sm-12 font-700 color-text">&nbsp;{{ bst.info }}</div>
                            {% endif %}
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
          {% for block in section.blocks %}
            {% if block.type == '@app' %}
              {% render block %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

