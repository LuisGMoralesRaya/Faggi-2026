{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}

{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .respone_image {
    border-radius: {{ sst.corner }}px;
    overflow: hidden;
  }
{% endstyle %}

<div class="container-outer{{ bg_class_full }}{% if sst.animate %} wow fadeInRight{% endif %} position-relative" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      {% if sst.pattern_1 != blank %}
        <div class="pattern-section pattern-1 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position1 }} {{ sst.pattern_animate1 }}" style="--horizontal: {{ sst.pattern_horizontal1 }}%;--vertical: {{ sst.pattern_vertical1 }}%;--width: {{ sst.pattern_width1 }}%;">
          {% render 'nov-aspect-image', image: sst.pattern_1, class: 'no-ef' %}
        </div>
      {% endif %}
      {% if sst.pattern_2 != blank %}
        <div class="pattern-section pattern-2 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position2 }} {{ sst.pattern_animate2 }}" style="--horizontal: {{ sst.pattern_horizontal2 }}%;--vertical: {{ sst.pattern_vertical2 }}%;--width: {{ sst.pattern_width2 }}%;">
          {% render 'nov-aspect-image', image: sst.pattern_2, class: 'no-ef' %}
        </div>
      {% endif %}
      {% if sst.pattern_3 != blank %}
        <div class="pattern-section pattern-3 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position3 }} {{ sst.pattern_animate3 }}" style="--horizontal: {{ sst.pattern_horizontal3 }}%;--vertical: {{ sst.pattern_vertical3 }}%;--width: {{ sst.pattern_width3 }}%;">
          {% render 'nov-aspect-image', image: sst.pattern_3, class: 'no-ef' %}
        </div>
      {% endif %}
      <div class="row align-items-center">
        <div class="col-lg-6">
          <div class="position-relative image-lookbook">
            {% if sst.lookbook_image != blank %}
              {% render 'nov-aspect-image', image: sst.lookbook_image %}
            {% else %}
              {%- capture current -%}{% cycle 1, 2, 3 %}{%- endcapture -%}
              {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}

            {% for block in section.blocks %}
              {% assign bst = block.settings %}
              {% if block.type == 'item' %}
                <div class="number nov-slick-dot position-absolute d-flex align-items-center justify-content-center r-100 pointer{% if forloop.first %} current{% endif %}" data-toggle="{{ section.id }}{{ forloop.index }}" style="top: {{ bst.pin_position_top }}%; left: {{ bst.pin_position_left }}%" data-index="{{ forloop.index0 }}">
                  <span class="postion-relative"></span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="col-lg-6 mt-md-40">
          <div class="block-product">
            {% render 'heading-section', sub_position: sst.subheading_position %}
            <div class="nov-slick-carousel grid--view-items position-relative row spacing-10" data-loop="false" data-items_xxl="1" data-nav="false" data-dots="false">
              {% for block in section.blocks %}
                {% if block.type == 'item' %}
                  <div class="sp-item item">
                    {% assign product = all_products[block.settings.pin_product] %}
                    {% render 'product-grid-item-style-1', product: product, section_id: section.id  %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          {% render block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

