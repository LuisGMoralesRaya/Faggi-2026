{%- liquid
  assign sst = section.settings
  assign collection_blog = blogs[sst.blog]
  assign blog_limit = sst.limit

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if sst.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}
{%- style -%}
  {% render 'nov-section-style' %}
  
  #shopify-section-{{ section.id }} .article__list-image-container {
    border-radius: {{ sst.item_corner_radius }}px;
  }
  #shopify-section-{{ section.id }} .item_bg_color .article--listing {
    border-radius: {{ sst.item_corner_radius }}px;
    background-color: {{ sst.item_bg_color }};
  }
{%- endstyle -%}

<div class="container-outer{{ bg_class_full }} color-{{ sst.color_section }} position-relative" data-section-id="{{ section.id }}" data-section-type="nov-swiper">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }} {{ sst.dots_color }} {{ sst.arrow_color }}">
      {% if sst.pattern_1 != blank %}
        <div class="pattern-section pattern-1 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position1 }} {{ sst.pattern_animate1 }}" style="--horizontal: {{ sst.pattern_horizontal1 }}%;--vertical: {{ sst.pattern_vertical1 }}%;--width: {{ sst.pattern_width1 }}%;">
          {% render 'nov-aspect-image', image: sst.pattern_1, class: 'no-ef' %}
        </div>
      {% endif %}
      {% if sst.pattern_2 != blank %}
        <div class="pattern-section pattern-2 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position2 }} {{ sst.pattern_animate2 }}" style="--horizontal: {{ sst.pattern_horizontal2 }}%;--vertical: {{ sst.pattern_vertical2 }}%;--width: {{ sst.pattern_width2 }}%;">
          {% render 'nov-aspect-image', image: sst.pattern_2, class: 'no-ef' %}
        </div>
      {% endif %}
      {% if sst.pattern_3 != blank %}
        <div class="pattern-section pattern-3 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position3 }} {{ sst.pattern_animate3 }}" style="--horizontal: {{ sst.pattern_horizontal3 }}%;--vertical: {{ sst.pattern_vertical3 }}%;--width: {{ sst.pattern_width3 }}%;">
          {% render 'nov-aspect-image', image: sst.pattern_3, class: 'no-ef' %}
        </div>
      {% endif %}
      {% render 'heading-section', sub_position: sst.subheading_position %}
      <div class="nov-swiper-carousel swiper{% if sst.show_item_bg_color %} item_bg_color{% endif %}{% if sst.item_bg_shadow %} item_shadow{% endif %}"
        data-autoplay="false" 
        data-loop="false"
        data-dots="{{ sst.show_dots }}"
        data-nav="{{ sst.show_nav }}"
        data-row="{{ sst.row }}"
        data-row_mobile="{{ sst.row }}"
        data-items_xxl="{{ sst.xxl }}"
        data-items_xl="{{ sst.xl }}"
        data-items_lg="{{ sst.lg }}"
        data-items_md="{{ sst.md }}"
        data-items_sm="{{ sst.sm }}"
        data-items_xs="1"
        data-spacing="{{ sst.spacing }}">
        <div class="swiper-wrapper">
          {% for article in collection_blog.articles limit: blog_limit %}
            <div class="swiper-slide item">
              <div class="article--listing overflow_hidden{% if sst.animate %} wow fadeInUp{% endif %}" data-wow-delay="{{ forloop.index | times: 0.1 }}s">
                {% if sst.show_image and article.image %}
                  <div class="article__list-image-container position-relative overflow_hidden">
                    <a href="{{ article.url }}">
                      {% render 'nov-aspect-image', image: article.image, aspect: 78 %}
                    </a>
                    {% if sst.blog_show_author %}
                      <span class="article__author fs-12 font-500 r-100 color-{{ sst.color_author }} position-absolute left-bottom">
                        {{ article.author }}
                      </span>
                    {% endif %}
                  </div>
                {% endif %}
                <div class="media-body mt-25">
                  {% if sst.blog_show_date %}
                    <div class="article_cs d-flex align-items-center color-text mb-10">
                      {% if sst.blog_show_date %}
                        <span class="article__date">
                          {{ article.published_at | date: "%b" }} {{ article.published_at | date: "%d" }}, {{ article.published_at | date: "%Y" }}
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="article__title">
                    <a href="{{ article.url }}" class="fs-24 fs-md-20 f_pr">{{ article.title | truncate: 70 }}</a>
                  </div>

                  {% if sst.blog_show_excerpt %}
                    <div class="article__excerpt mt-10 color-text">
                      {% if article.excerpt.size > 0 %}
                      {{ article.excerpt | truncate: 100 }}
                      {% else %}
                      {{ article.content | strip_html | truncate: 100 }}
                      {% endif %}
                    </div>
                  {% endif %}
                  
                  {% if sst.show_readmore %}
                    <a href="{{ article.url }}" class="view_all link font-600 d-inline-flex align-items-center text-capitalize mt-25">
                      <span>{{ 'sections.button.read_more' | t }}</span>
                      <i class="zmdi zmdi-long-arrow-right"></i>
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>    
          {% else %}
            {%- for i in (1..4) -%}
              {%- capture current -%}{% cycle 1, 2, 3 %}{%- endcapture -%}
              <div class="swiper-slide item">
                {{ 'blog-apparel-' | append: current | placeholder_svg_tag : 'placeholder-svg' }}
              </div>
            {%- endfor -%}
          {% endfor %}
        </div>
        {% if sst.show_nav or sst.show_dots %}
          <div class="d-flex align-items-center justify-content-center mt-60 mt-sm-30">
            {% if sst.show_nav %}
              <div class="nav-arrow nav-prev pointer"></div>
            {% endif %}
            {% if sst.show_dots %}
              <div class="swiper-pagination"></div>
            {% endif %}
            {% if sst.show_nav %}
              <div class="nav-arrow nav-next pointer"></div>
            {% endif %}
          </div>
        {%- endif -%}
      </div>
      {% if sst.show_view_all_blog %}
        <div class="text-center mt-60">
          <a href="{{ collection_blog.url }}" class="btn btn-large">
            <span>{{ 'sections.blog.view_all_blog' | t }}</span>
            <span class="zmdi zmdi-long-arrow-right"></span>
          </a>
        </div>
      {% endif %}

      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          {% render block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
