{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}

{% style %}
  {% render 'nov-section-style' %}
  #shopify-section-{{ section.id }} .nov-sh-image-2 {
    border-radius: {{ sst.image_corner }}px;
  }
  {% if sst.show_nav %}
    #shopify-section-{{ section.id }} .nav-arrow {
      --slider-arrow-color: {{ sst.slider_arrow_color }};
      --slider-arrow-color-act: {{ sst.slider_arrow_color_act }};
    }
  {% endif %}
{% endstyle %}
<div class="{{ bg_class_full }}">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}{% if sst.animate %} wow fadeInUp{% endif %}">
      {% if sst.show_nav %}
        <div class="d-md-flex align-items-center justify-content-between mb-45 mb-sm-20">
          {% render 'heading-section', sub_position: sst.subheading_position, class: 'mb-0' %}
          <div class="slider-direction d-flex align-items-center mt-sm-20">
            <div class="nav-arrow nav-prev pointer">
              {% render 'icon-arrow-left' %}
            </div>
            <div class="nav-arrow nav-next pointer">
              {% render 'icon-arrow-right' %}
            </div>
          </div>
        </div>
      {% else %}
        {% render 'heading-section', sub_position: sst.subheading_position %}
      {% endif %}
      <div class="row">
        <div class="col-xl-20 col-md-4">
          <ul class="nav nav-tabs list-unstyled d-none d-md-block color-{{ sst.color_tab }}">
            {% for block in section.blocks %}
              {% if block.type == 'item' %}
                <li class="nav-item position-relative{% if forloop.last == false %} mb-5{% endif %}">
                  <a href="#" class="nav-link tab-links w-100 justify-content-between text-capitalize btn {{ sst.btn_type_color }}{% if forloop.first %} active{% endif %}" data-target="#{{ forloop.index }}{{ section.id }}" data-toggle="tab">
                    <span>{{ block.settings.title }}</span>
                    <i class="zmdi zmdi-chevron-right"></i>
                  </a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
          <div class="nav-mobile nov_ud_toggle d-md-none mb-20">
            <div class="nov_ud_group position-relative">
              <div class="nov_ud_btn nav-mobile__title d-flex align-items-center justify-content-between w-100">
              </div>
              <div class="nov_ud_dropdown nav w-100 p-0">
                {% for block in section.blocks %}
                  {% if block.type == 'item' %}
                    <a class="nav-link tab-links{% if forloop.first %} active{% endif %}" data-target="#{{ forloop.index }}{{ section.id }}" data-toggle="tab">
                      <span>{{ block.settings.title }}</span>
                    </a>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
        <div class="col-xl-80 col-md-8">
          <div class="collection-tabs-content position-relative">
            {% for block in section.blocks %}
              {% if block.type == 'item' %}
              <div class="tab-content{% if forloop.first %} active{% endif %}" id="{{ forloop.index }}{{ section.id }}">
                <div class="section-slick-carousel row spacing-{{ sst.spacing }} spacing-md-{{ sst.spacing_md }}" data-items_xxl="{{ sst.xxl }}" data-items_xl="{{ sst.xl }}" data-items_lg="{{ sst.lg }}" data-items_md="{{ sst.md }}" data-items_sm="{{ sst.sm }}" data-items_xs="{{ sst.xs }}">
                  {% for i in (1..8) %}
                    {% liquid
                      assign image = 'image' | append: i
                      assign heading = 'heading' | append: i
                      assign link = 'link' | append: i
                    %}
                    {% if block.settings[image] != blank %}
                      <div class="item sp-item {% render 'number-to-col', xxl: sst.xxl, xl: sst.xl, lg: sst.lg, md: sst.md, sm: sst.sm, xs: sst.xs  %}">
                        <div class="nov-slick-carousel__item position-relative">
                          <div class="nov-sh-image-2">
                            {% render 'nov-aspect-image', image: block.settings[image] %}
                          </div>
                          {% if block.settings[heading] != blank %}
                            <a href="{{ block.settings[link] }}" class="position-absolute bottom-center h6 text-uppercase mb-0 color-{{ sst.color_title }}">
                              {{ block.settings[heading] }}
                            </a>
                          {% endif %}
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          {% render block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
