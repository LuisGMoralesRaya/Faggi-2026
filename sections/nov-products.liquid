{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif

  assign collection = collections[sst.collection]
  assign product_limit = sst.limit
-%}
{% style %}
  {% render 'nov-section-style' %}


  {% if sst.layout_type == 'grid' %}
    #shopify-section-{{ section.id }} .grid-wrapper {
      margin: -{{ sst.spacing | divided_by: 2 }}px;
    }
    #shopify-section-{{ section.id }} .grid-wrapper .item {
      padding: {{ sst.spacing | divided_by: 2 }}px;
    }
    @media(max-width: 575px) {
      #shopify-section-{{ section.id }} .grid-wrapper {
        margin: -15px -7.5px;
      }
      #shopify-section-{{ section.id }} .grid-wrapper .item {
        padding: 15px 7.5px;
      }
    }
  {% endif %}
  {% if sst.show_nav %}
    #shopify-section-{{ section.id }} .nav-arrow {
      --slider-arrow-color: {{ sst.slider_arrow_color }};
      --slider-arrow-color-act: {{ sst.slider_arrow_color_act }};
    }
  {% endif %}

  {% if sst.show_pagination_progress %}
    #shopify-section-{{ section.id }} .swiper-scrollbar {
      background: {{ sst.pagination_progress_bg }} !important;
    }
    #shopify-section-{{ section.id }} .swiper-scrollbar-drag {
      background: {{ sst.progress_bg }} !important;
    }
  {% endif %}

  {% if sst.enable_custom_style %}
    #shopify-section-{{ section.id }} {
      --product-color-border: {{ sst.product_border_color }};
      --product-color-background: {{ sst.product_background_color }};
      --product-color-type: {{ sst.product_type_color }};
      --product-color-title: {{ sst.product_title_color }};
      --product-color-title-hover: {{ sst.product_title_color_hover }};
      --product-color-price: {{ sst.product_price_color }};
      --product-color-reduced-price: {{ sst.product_price_reduced_color }};
    }
  {% endif %}
{% endstyle %}
<div class="{{ bg_class_full }} position-relative" data-section-id="{{ section.id }}" data-section-type="nov-swiper">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }} {{ sst.dots_color }}{% if sst.animate %} wow fadeInUp{% endif %}">
      {% if sst.pattern_1 != blank %}
        <div class="pattern-section pattern-1 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position1 }} {{ sst.pattern_animate1 }}" style="--horizontal: {{ sst.pattern_horizontal1 }}%;--vertical: {{ sst.pattern_vertical1 }}%;--width: {{ sst.pattern_width1 }}%;">
          {% render 'nov-aspect-image', image: sst.pattern_1, class: 'no-ef' %}
        </div>
      {% endif %}
      {% if sst.pattern_2 != blank %}
        <div class="pattern-section pattern-2 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position2 }} {{ sst.pattern_animate2 }}" style="--horizontal: {{ sst.pattern_horizontal2 }}%;--vertical: {{ sst.pattern_vertical2 }}%;--width: {{ sst.pattern_width2 }}%;">
          {% render 'nov-aspect-image', image: sst.pattern_2, class: 'no-ef' %}
        </div>
      {% endif %}
      {% if sst.pattern_3 != blank %}
        <div class="pattern-section pattern-3 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position3 }} {{ sst.pattern_animate3 }}" style="--horizontal: {{ sst.pattern_horizontal3 }}%;--vertical: {{ sst.pattern_vertical3 }}%;--width: {{ sst.pattern_width3 }}%;">
          {% render 'nov-aspect-image', image: sst.pattern_3, class: 'no-ef' %}
        </div>
      {% endif %}
      {% render 'heading-section', sub_position: sst.subheading_position %}

      <div class="grid--view-items{% if sst.layout_type == 'slider' %} nov-swiper-carousel swiper{% if sst.right_overflow %} overflow-right{% endif %}{% endif %}"
        {% if sst.layout_type == 'slider' %}
          data-autoplay="false" 
          data-autoplayTimeout="6000"
          data-loop="false"
          data-row="{{ sst.row_number }}"
          data-row_mobile="{{ sst.row_mobile }}"
          data-items_xxl="{{ sst.xxl }}"
          data-items_xl="{{ sst.xl }}"
          data-items_lg="{{ sst.lg }}"
          data-items_md="{{ sst.md }}"
          data-items_sm="{{ sst.sm }}"
          data-items_xs="{{ sst.xs }}"
          data-spacing="{{ sst.spacing }}"
          data-spacing_mobile="15"
        {% endif %}
      >
        <div class="{% if sst.layout_type == 'slider' %}swiper-wrapper{% else %}grid-wrapper row{% endif %}">
          {% for product in collection.products limit: product_limit %}
            <div class="{% if sst.layout_type == 'slider' %}swiper-slide{% else %}{% render 'number-to-col', xxl: sst.xxl, xl: sst.xl, lg: sst.lg, md: sst.md, sm: sst.sm, xs: sst.xs  %}{% endif %} item">
              {% render 'product-grid-item-style-1-1', product: product, section_id: section.id %}
            </div>
          {% else %}
            {%- for i in (1..6) -%}
              {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
              <div class="{% if sst.layout_type == 'slider' %}swiper-slide{% else %}{% render 'number-to-col', xxl: sst.xxl, xl: sst.xl, lg: sst.lg, md: sst.md, sm: sst.sm, xs: sst.xs  %}{% endif %} item">
                {{ 'product-apparel-' | append: current | placeholder_svg_tag : 'placeholder-svg' }}
              </div>
            {%- endfor -%}
          {% endfor %}
        </div>
        {% if sst.show_pagination_progress %}
          <div class="swiper-scrollbar mt-80 mt-md-40 position-static"></div>
        {% endif %}
        {% if sst.layout_type == 'slider' %}
          {% if sst.show_nav or sst.show_dots %}
            <div class="d-flex align-items-center justify-content-center mt-60">
              {% if sst.show_nav %}
                <div class="nav-arrow nav-prev pointer">
                  {% render 'icon-arrow-left' %}
                </div>
              {% endif %}
              {% if sst.show_dots %}
                <div class="swiper-pagination"></div>
              {% endif %}
              {% if sst.show_nav %}
                <div class="nav-arrow nav-next pointer">
                  {% render 'icon-arrow-right' %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endif %}
      </div>
      {% if sst.viewall_label != blank %}
        <div class="text-center mt-65 mt-sm-30">
          <a href="{{ collection.url }}" class="btn btn-large">
            <span>{{ sst.viewall_label }}</span>
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>
