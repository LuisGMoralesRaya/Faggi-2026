{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif

-%}
{% style %}
  {% render 'nov-section-style' %}
  #shopify-section-{{ section.id }} .policy-icon {
    background: {{ sst.icon_bg }}
  } 
{% endstyle %}
<div class="{{ bg_class_full }} position-relative" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }} {{ sst.dots_color }}{% if sst.animate %} wow fadeInUp{% endif %}">
      <div class="row spacing-60 spacing-lg-40 spacing-md-30">
        <div class="block-left col-md-5 d-flex flex-column justify-content-between mb-sm-40">
          {% render 'heading-section', sub_position: sst.subheading_position %}
          <div class="block-tab row color-{{ sst.color_button }} {{ sst.button_type_color }}">
            {% for block in section.blocks %}
              {% if block.settings.tab_label != blank %}
                <div class="block-tab-item">
                  <div class="btn nov-slick-dot{% if forloop.first %} current{% endif %}" data-index="{{ forloop.index0 }}">
                    {{ block.settings.tab_label }}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="block-center col-md-7">
          <div class="nov-slick-carousel"
            data-autoplay="false" 
            data-autoplayTimeout="6000"
            data-loop="true"
            data-nav="false"
            data-dots="false"
            data-row="1"
            data-row_mobile="1"
            data-items_xxl="1"
            data-speed="700"
          >
            {% for block in section.blocks %}
              <div class="sp-item item">
                <div class="position-relative">
                  {% if block.settings.image != blank  %}
                    {% render 'nov-aspect-image', image: block.settings.image %}
                  {% else %}
                    {{ 'product-apparel-1' | placeholder_svg_tag : 'placeholder-svg' }}
                  {% endif %}
                  {% if block.settings.tab_label != blank %}
                    <div class="tab-label position-absolute d-flex align-items-center fs-12 font-500 left-top color-{{ sst.color_label }}">
                      {{ block.settings.tab_label }}
                    </div>
                  {% endif %}
                  {% if block.settings.title != blank or block.settings.stitle != blank or block.settings.desc != blank %}
                    <div class="block-img-content position-absolute bottom-center color-{{ sst.color_img_content }}">
                      {% if block.settings.stitle != blank %}
                        <div class="fs-12 font 500 color-text mb-10">{{ block.settings.stitle }}</div>
                      {% endif %}
                      {% if block.settings.title != blank %}
                        <div class="fs-24 fs-md-20 h3 color-title">{{ block.settings.title }}</div>
                      {% endif %}
                      {% if block.settings.desc != blank %}
                        <div class="color-text mt-10">{{ block.settings.desc }}</div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="block-right col-xl-4 mt-lg-40 color-{{ sst.color_block_right }}">
          {% if sst.bl_right_title != blank %}
            <div class="bl-right-title h2 fs-28 fs-xs-24 color-title">{{ sst.bl_right_title }}</div>
          {% endif %}
          {% if sst.bl_right_desc != blank %}
            <div class="bl-right-desc fs-14 font-500 mt-15">{{ sst.bl_right_desc }}</div>
          {% endif %}
          <div class="block-policy row spacing-15 mt-30">
            {% for i in (1..5) %}
              {%- liquid
                assign bl_icon_id = 'bl_icon' | append: i
                assign bl_number_id = 'bl_number' | append: i
                assign bl_title_id = 'bl_title' | append: i
                assign bl_unit_id = 'bl_unit' | append: i
                assign bl_title_id = 'bl_title' | append: i
              -%}
              {% if sst[bl_icon_id] != blank or sst[bl_number_id] != 0 or sst[bl_title_id] != blank %}
                <div class="item-col col-xl-12 col-sm-6">
                  <div class="policy-item d-flex align-items-center">
                    <div class="policy-icon r-100 d-flex align-items-center justify-content-center">
                      <div class="icon-img">
                        {% render 'nov-aspect-image', image: sst[bl_icon_id] %}
                      </div>
                    </div>
                    <div class="policy-content">
                      <div class="policy-number h3 fs-20 fs-lg-18 mb-0 color-title">
                        <span class="number-animate" data-number="{{ sst[bl_number_id] }}">0</span>
                        {{ sst[bl_unit_id] }}
                      </div>
                      <div class="policy-title">{{ sst[bl_title_id] }}</div>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
          {% if sst.bl_right_button_label != blank %}
            <div class="text-center mt-30">
              <a href="{{ sst.bl_right_button_link }}" class="bl_right_title btn w-100">{{ sst.bl_right_button_label }}</a>
            </div>
          {% endif %}
        </div>
      </div>
      
    </div>
  </div>
</div>
