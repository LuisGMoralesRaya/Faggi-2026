{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif

  assign collection = collections[sst.collection]
  assign product_limit = sst.limit
-%}

{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .countdownfree .data-number {
    color: {{ sst.c_cd }};
    background-color: {{ sst.bg_cd }};
    border: 1px solid {{ sst.bd_cd }};
  }
  #shopify-section-{{ section.id }} .countdownfree .name-time,
  #shopify-section-{{ section.id }} .countdownfree .data-number:after {
    color: {{ sst.name_cd }};
  }
  {% if sst.video_img != blank %}
    #shopify-section-{{ section.id }} .block-video {
      border-radius: {{ sst.video_corner }}px;
    }
  {% endif %}

  {% if sst.enable_custom_style %}
    #shopify-section-{{ section.id }} {
      --product-color-border: {{ sst.product_border_color }};
      --product-color-background: {{ sst.product_background_color }};
      --product-color-type: {{ sst.product_type_color }};
      --product-color-title: {{ sst.product_title_color }};
      --product-color-title-hover: {{ sst.product_title_color_hover }};
      --product-color-price: {{ sst.product_price_color }};
      --product-color-reduced-price: {{ sst.product_price_reduced_color }};
    }
  {% endif %}
{% endstyle %}
<div class="{{ bg_class_full }}{% if sst.animate %} wow fadeInUp{% endif %}" data-section-id="{{ section.id }}" data-section-type="nov-swiper">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }} {{ sst.arrow_color }}">

      <div class="row mb-80 mb-lg-60 mb-sm-40">
        <div class="{% if sst.video_img != blank %}col-md-5{% else %} col-12{% endif %} mb-sm-30">
          {% render 'heading-section', sub_position: sst.subheading_position, class: 'mb-30' %}
          <div class="countdownfree d-flex justify-content-start text-center mt-20" data-countdown="{{ sst.countdown_timeend }}" data-show-days="{{ settings.show_day }}" data-restart="{{ settings.restart }}"></div>
          {% if sst.btn_label != blank %}
            <a href="{{ sst.btn_link }}" class="btn mt-30">
              <span>{{ sst.btn_label }}</span>
              <i class="zmdi zmdi-long-arrow-right"></i>
            </a>
          {% endif %}
        </div>
        {% if sst.video_img != blank %}
          <div class="col-md-7">
            <div class="block-video h-100 position-relative overflow_hidden color-{{ sst.color_video }}">
              {% render 'nov-aspect-image', image: sst.video_img %}
              <div class="position-absolute center-center text-center" data-id="{{ section.id }}">
                <div class="icon_play {{ sst.video_btn_color }}" data-toggle="modal" data-target="#ModalVideo" data-src="{% if sst.video_url.type == "youtube"  %}https://www.youtube.com/embed/{{ sst.video_url.id }}?rel=0&showinfo=0&vq=720{% endif %}{% if sst.video_url.type == "vimeo" %}//player.vimeo.com/video/{{ sst.video_url.id }}?byline=0&portrait=0&badge=0{% endif %}">
                  {% render 'icon-caret-right' %}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      </div>

      <div class="nov-swiper-carousel swiper list--view-item"
        data-loop="false"
        data-row="{{ sst.row_number }}"
        data-row_mobile="{{ sst.row_mobile }}"
        data-items_xxl="{{ sst.xxl }}"
        data-items_xl="{{ sst.xl }}"
        data-items_lg="{{ sst.lg }}"
        data-items_md="{{ sst.md }}"
        data-items_sm="{{ sst.sm }}"
        data-items_xs="{{ sst.xs }}"
        data-speed="700"
        data-spacing="{{ sst.spacing }}">
        <div class="swiper-wrapper">
          {% for product in collection.products limit: product_limit %}
            <div class="swiper-slide item">
              {% render 'product-grid-item-style-deal', product: product, section_id: section.id %}
            </div>
          {% else %}
            {%- for i in (1..4) -%}
              <div class="item {% render 'number-to-col', xxl: sst.xxl, xl: sst.xl, lg: sst.lg, md: sst.md, sm: sst.sm, xs: sst.xs  %}">
                {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                {{ 'product-apparel-' | append: current | placeholder_svg_tag : 'placeholder-svg' }}
              </div>
            {%- endfor -%}
          {% endfor %}
        </div>
        {%- if sst.show_nav -%}
          <div class="d-flex align-items-center justify-content-center mt-xl-30">
            <div class="nav-arrow nav-prev pointer absolute" style="--start: 5px"></div>
            <div class="nav-arrow nav-next pointer absolute" style="--end: 5px"></div>
          </div>
        {%- endif -%}
      </div>
      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          {% render block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

