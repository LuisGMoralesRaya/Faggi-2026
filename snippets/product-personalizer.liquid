{%- liquid
  assign supported_personalization_tags = 'Personalizacion_1,Personalizacion_2,Personalizacion_3,Personalizacion_4,Personalizacion_5,Personalizacion_6,Personalizacion_7,Personalizacion_8,Personalizacion_9' | split: ','
  assign active_personalization_tag = blank

  for supported_tag in supported_personalization_tags
    if product.tags contains supported_tag
      assign active_personalization_tag = supported_tag
      break
    endif
  endfor

  assign personalizer_font_blocks = section.blocks | where: 'type', 'personalizer_font'
  assign shape_option_names = section.settings.personalizer_shape_option_names | split: ','
  assign charm_collection_handle = section.settings.personalizer_charm_collection | default: 'charms-bar'
  assign charm_collection = collections[charm_collection_handle]
-%}

{%- if section.settings.enable_product_personalizer and active_personalization_tag != blank -%}
  {{ 'product-personalizer.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-personalizer.js' | asset_url }}" defer></script>

  <div
    class="product-personalizer"
    data-product-personalizer
    data-section-id="{{ section.id }}"
    data-form-id="product-form-{{ section.id }}"
    data-active-tag="{{ active_personalization_tag }}"
  >
    {%- comment -%} ── Inline trigger button (always visible in PDP) ── {%- endcomment -%}
    <button type="button" class="pp-trigger" data-action="open-personalizer">
      <span class="pp-trigger__icon" aria-hidden="true">&#10022;</span>
      <span class="pp-trigger__copy">
        <span class="pp-trigger__title">{{ section.settings.personalizer_heading | default: 'Personaliza tu pieza' | escape }}</span>
        <span class="pp-trigger__subtitle" data-pp-trigger-subtitle>Toca para configurar tu diseño</span>
      </span>
      <span class="pp-trigger__check" data-pp-trigger-check hidden aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="currentColor"/><path d="M5.5 9.5L7.5 11.5L12.5 6.5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="pp-trigger__arrow" aria-hidden="true">&rarr;</span>
    </button>

    {%- comment -%} ── Hidden properties (inside form, submitted with cart) ── {%- endcomment -%}
    <div data-personalizer-properties style="display:none"></div>

    {%- comment -%} ── Modal overlay ── {%- endcomment -%}
    <div class="pp-modal" data-pp-modal hidden>
      <div class="pp-modal__backdrop" data-action="close-personalizer"></div>
      <div class="pp-modal__dialog" role="dialog" aria-modal="true" aria-label="Personalizador de producto">

        {%- comment -%} Modal header {%- endcomment -%}
        <div class="pp-modal__header">
          <div class="pp-modal__header-copy">
            <p class="pp-modal__eyebrow">{{ section.settings.product_eyebrow | escape }}</p>
            <h2 class="pp-modal__heading">{{ section.settings.personalizer_heading | escape }}</h2>
            <span class="pp-modal__badge" data-preview-rule-label>{{ active_personalization_tag | replace: 'Personalizacion_', 'Personalizado ' }}</span>
          </div>
          <button type="button" class="pp-modal__close" data-action="close-personalizer" aria-label="Cerrar personalizador">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        {%- comment -%} Modal body — two-column layout {%- endcomment -%}
        <div class="pp-modal__body">
          <div class="pp-modal__subtitle">{{ section.settings.personalizer_subheading | escape }}</div>
          {%- if section.settings.personalization_note != blank -%}
            <div class="pp-modal__note rte">{{ section.settings.personalization_note }}</div>
          {%- endif -%}

          <div class="pp-modal__layout">
            {%- comment -%} Preview column {%- endcomment -%}
            <div class="pp-modal__preview-col">
              <div class="pp-card pp-card--preview">
                <div class="pp-card__header">
                  <div>
                    <p class="pp-card__eyebrow">Preview</p>
                    <h3 class="pp-card__title">Vista previa</h3>
                  </div>
                  <span class="pp-card__shape-pill" data-preview-shape-badge hidden></span>
                </div>
                <div class="pp-preview" data-preview-stage>
                  <div class="pp-preview__empty" data-preview-empty>
                    <span class="pp-preview__empty-icon">+</span>
                    <p>{{ section.settings.personalizer_preview_empty | escape }}</p>
                  </div>
                  <div class="pp-preview__main" data-preview-main></div>
                  <div class="pp-preview__gallery" data-preview-gallery hidden></div>
                  <div class="pp-preview__charms" data-preview-charms hidden></div>
                </div>
              </div>

              <div class="pp-card pp-card--summary">
                <div class="pp-card__header">
                  <div>
                    <p class="pp-card__eyebrow">Resumen</p>
                    <h3 class="pp-card__title">{{ section.settings.personalizer_summary_title | escape }}</h3>
                  </div>
                </div>
                <div class="pp-summary" data-summary-list></div>
              </div>
            </div>

            {%- comment -%} Controls column {%- endcomment -%}
            <div class="pp-modal__controls-col">
              <div class="pp-status" data-personalizer-status></div>
              <div class="pp-errors" data-personalizer-errors></div>
              <div class="pp-fields" data-personalizer-fields></div>
            </div>
          </div>
        </div>

        {%- comment -%} Modal footer {%- endcomment -%}
        <div class="pp-modal__footer">
          <button type="button" class="pp-modal__confirm" data-action="confirm-personalizer">
            Confirmar personalización
          </button>
        </div>

      </div>
    </div>

    {%- comment -%} ── Config JSON ── {%- endcomment -%}
    <script type="application/json" data-personalizer-config>
      {
        "sectionId": {{ section.id | json }},
        "activeTag": {{ active_personalization_tag | json }},
        "productId": {{ product.id | json }},
        "productTitle": {{ product.title | json }},
        "productHandle": {{ product.handle | json }},
        "productUrl": {{ product.url | json }},
        "productTags": {{ product.tags | json }},
        "selectedVariantId": {{ product.selected_or_first_available_variant.id | json }},
        "variants": {{ product.variants | json }},
        "shapeOptionNames": {{ shape_option_names | json }},
        "fonts": [
          {%- for block in personalizer_font_blocks -%}
            {
              "id": {{ block.id | json }},
              "label": {{ block.settings.title | json }},
              "family": {{ block.settings.font_family | json }},
              "weight": {{ block.settings.font_weight | json }},
              "style": {{ block.settings.font_style | json }},
              "previewText": {{ block.settings.preview_text | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "charms": [
          {%- if charm_collection != blank -%}
            {%- for charm_product in charm_collection.products -%}
              {
                "id": {{ charm_product.id | json }},
                "code": {{ charm_product.handle | json }},
                "label": {{ charm_product.title | json }},
                "description": {{ charm_product.description | strip_html | truncate: 80 | json }},
                "accent": "#b9996e",
                "image": {% if charm_product.featured_image != blank %}{{ charm_product.featured_image | image_url: width: 280 | json }}{% else %}null{% endif %},
                "price": {{ charm_product.price | json }},
                "variantId": {{ charm_product.selected_or_first_available_variant.id | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        ],
        "ui": {
          "heading": {{ section.settings.personalizer_heading | json }},
          "subheading": {{ section.settings.personalizer_subheading | json }},
          "summaryTitle": {{ section.settings.personalizer_summary_title | json }},
          "emptyPreview": {{ section.settings.personalizer_preview_empty | json }},
          "iconHelp": {{ section.settings.personalizer_icon_help | json }},
          "shapeConsumesNote": {{ section.settings.personalizer_shape_consumes_note | json }}
        }
      }
    </script>

    <noscript>
      <div class="pp-noscript">
        Activa JavaScript para personalizar esta pieza antes de agregarla al carrito.
      </div>
    </noscript>
  </div>
{%- endif -%}
