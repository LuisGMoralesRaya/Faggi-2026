<form action="{{ routes.search_url }}" method="get" class="search-header-inline{% if settings.show_border_product %} product-has-border{% endif %}" role="search">
	<div class="search-header__content position-relative">
		<div class="search-header__placeholder text-animate-js">{{ 'general.search.i_am_looking_for' | t }}</div>
		<input type="hidden" name="type" value="product">
		<input class="search-header__input"
		type="search"
		name="q"
		placeholder="{{ 'general.search.title' | t }}"
		aria-label="{{ 'general.search.title' | t }}"
		autocomplete="off">
		<button class="search-header__submit d-flex align-items-center justify-content-center{% if section.settings.search_btn_color %} color-{{ section.settings.search_btn_color }} {{ section.settings.search_btn_color_type }}{% endif %}" type="submit" title="{{ 'general.search.submit' | t }}">
			<span class="search-header__submit-icon">
				{% render 'icon-search' %}
			</span>
			<span class="search-header__submit-text d-none fs-12 font-600 text-uppercase f_pr">
				{{ 'general.search.submit' | t }}
			</span>
		</button>
		<div class="btn-search__clear-text hide position-absolute pointer"><i class="zmdi zmdi-close-circle"></i></div>
	</div>
	<div class="search_overlay"></div>
	<div class="search_autocomplete">
		<div class="search_autocomplete-content">
			{% if settings.show_key_trend %}
				<div class="search_trend">
					<div class="search_trend-content">
					<div class="search_trend-title h4 color-title fs-14 mb-30">{{ 'general.search.search_trend' | t }}</div>
					<div class="list-item d-flex">
						{% for i in (1..6) %}
							{% assign key_trend_id = 'key_trend_' | append: i %}
							{% if settings[key_trend_id] != blank %}
								<a href="{{ routes.search_url }}?type=product&q={{ settings[key_trend_id] | replace: ' ','%20' }}" class="search-trend-item btn btn-secondary">
									<span>{{ settings[key_trend_id] }}</span>
								</a>
							{% endif %}
						{% endfor %}
					</div>
					</div>
				</div>
			{% endif %}
		</div>
	</div>
	
</form>
