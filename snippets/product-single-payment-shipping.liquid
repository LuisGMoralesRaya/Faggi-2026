{%- liquid
  assign payment_heading = section.settings.title_payments | default: '¿Por qué elegir Faggi?'
  assign payment_copy = section.settings.payments_copy
  assign payment_image = section.settings.payments
  assign ship_time = section.settings.time
  assign ship_truck = section.settings.truck

  if product.metafields.custom.faggi_payment_title != blank
    assign payment_heading = product.metafields.custom.faggi_payment_title.value | default: product.metafields.custom.faggi_payment_title
  endif

  if product.metafields.custom.faggi_payment_text != blank
    assign payment_copy = product.metafields.custom.faggi_payment_text.value | default: product.metafields.custom.faggi_payment_text
  endif

  if product.metafields.custom.faggi_payment_image != blank
    assign payment_image = product.metafields.custom.faggi_payment_image.value | default: product.metafields.custom.faggi_payment_image
  endif

  if product.metafields.custom.faggi_ship_time != blank
    assign ship_time = product.metafields.custom.faggi_ship_time.value | default: product.metafields.custom.faggi_ship_time
  endif

  if product.metafields.custom.faggi_shipping_text != blank
    assign ship_truck = product.metafields.custom.faggi_shipping_text.value | default: product.metafields.custom.faggi_shipping_text
  endif
-%}

{% if section.settings.show_payments %}
  <div class="product-single__payment mt-45 mb-45" style="--width-payment: {{ section.settings.payments_width }}px;">
    {% if payment_heading != blank %}
      <div class="product-single__control-label mb-10">{{ payment_heading }}</div>
    {% endif %}

    {% if payment_image != blank %}
      <div class="payments overflow-hidden">
        <img
          class="lazyload"
          src="{{ payment_image | image_url: width: 1 }}"
          data-src="{{ payment_image | image_url: width: 700 }}"
          width="{{ section.settings.payments_width }}"
          height="{{ section.settings.payments_width | divided_by: payment_image.aspect_ratio | round }}"
          alt="{{ payment_heading | default: product.title | escape }}"
        />
      </div>
    {% else %}
      <div class="payments overflow-hidden d-flex justify-content-center flex-wrap">
        {%- for type in shop.enabled_payment_types -%}
          <div class="payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</div>
        {%- endfor -%}
      </div>
    {% endif %}

    {% if payment_copy != blank %}
      <div class="payments__copy rte">
        {{ payment_copy }}
      </div>
    {% endif %}
  </div>
{% endif %}

<div class="product-single__shiping">
  {% if ship_time != blank %}
    <div class="shiping_time d-flex align-items-center" style="color: {{ section.settings.color_time }};font-size: {{ section.settings.size_time }};">
      <i class="rbb-icon-delivery-1"></i>
      <span>{{ ship_time }}</span>
    </div>
  {% endif %}
  {% if ship_truck != blank %}
    <div class="shiping_truck d-flex align-items-center" style="color: {{ section.settings.color_truck }};font-size: {{ section.settings.size_truck }};">
      <i class="rbb-icon-delivery-11"></i>
      <span>{{ ship_truck }}</span>
    </div>
  {% endif %}
</div>
